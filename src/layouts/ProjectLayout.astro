---
import type { CollectionEntry } from "astro:content"
import { Users, Search, MessageSquare, Star, Linkedin, Copy, ArrowUpRight, X } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"
import CaseStudySection from "@/components/CaseStudySection.astro"
import { Badge } from "@/components/ui/badge"
import { projectThemes, themeToCssVars } from "@/data/project-colors"

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const {
  title,
  description,
  company,
  companyUrl,
  role,
  industry,
  timeframe,
  skills,
  heroImage,
  heroImageRounded,
  heroLogo,
  cardTag,
  problem,
  approachItems,
  solutionSections,
  highlights,
  testimonial,
  ctaHeading,
} = project.data

const theme = projectThemes[project.slug]
const heroStyle = theme ? themeToCssVars(theme) : undefined
// The content zone between the hero and the impact section sits on the
// site's normal light/dark surface (so the theme toggle actually affects
// it), not the brand color. It reads from the --surface-* tokens instead
// of --background/--foreground directly, since those get overridden
// page-wide by heroStyle on <html> (see BaseLayout's themeVars) — aliasing
// straight to --background here would just inherit the brand color back.
const contentStyle = {
  "--background": "var(--surface)",
  "--foreground": "var(--surface-foreground)",
  "--muted-foreground": "var(--surface-muted-foreground)",
  "--border": "var(--surface-border)",
  "--muted": "var(--surface-muted)",
  ...(theme
    ? { "--accent": theme.accent, "--accent-foreground": theme.accentForeground, "--ring": theme.ring }
    : {}),
}

const hasRichLayout = Boolean(solutionSections && solutionSections.length > 0)

// Experiment: image lightbox, scoped to a single project for now while we
// try it out. Promote to a frontmatter field once the pattern is validated.
const hasImageLightbox = project.slug === "accuray-radiotherapy"

const approachIcons = {
  users: Users,
  search: Search,
  "message-square": MessageSquare,
  star: Star,
}

const navItems = [
  { id: "problem", label: "The Problem", show: Boolean(problem) },
  { id: "approach", label: "Approach", show: Boolean(approachItems?.length) },
  { id: "solutions", label: "Solutions", show: Boolean(solutionSections?.length) },
  { id: "impact", label: "Impact", show: Boolean(highlights?.length) },
].filter((item) => item.show)

// Splits a highlight string on *emphasis* markers so key phrases can be
// rendered in the accent color, e.g. "Closed *10+ enterprise* deals".
function splitHighlight(text: string) {
  return text.split(/\*(.*?)\*/g).map((part, i) => ({ text: part, emphasis: i % 2 === 1 }))
}

// Same eyebrow-label style as the "Work" / "About" tags on the home page.
const labelClass = "text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase"
const rowClass = "grid grid-cols-1 gap-6 scroll-mt-28 md:grid-cols-[200px_1fr] md:gap-16"
---

<BaseLayout title={`${title} — Gilbert Vega`} description={description} themeVars={heroStyle}>
  <div id="page-curtain" aria-hidden="true"></div>
  {
    hasRichLayout ? (
      <article>
        <div id="hero" style={heroStyle} class="w-full bg-background text-foreground">
          <div class="mx-auto w-full max-w-5xl px-6 py-6 sm:px-8">
            <a
              href="/#work"
              class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
              &larr; Back to work
            </a>

            <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center lg:gap-12">
              <div class="flex flex-col gap-5">
                {heroLogo &&
                  (companyUrl ? (
                    <a href={companyUrl} target="_blank" rel="noopener noreferrer" class="mb-2 self-start">
                      <img src={heroLogo} alt={company} class="h-auto max-h-9 w-auto max-w-32" />
                    </a>
                  ) : (
                    <img src={heroLogo} alt={company} class="mb-2 h-auto max-h-9 w-auto max-w-32 self-start" />
                  ))}
                <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
                {cardTag && (
                  <div>
                    <Badge variant="secondary">{cardTag}</Badge>
                  </div>
                )}
              </div>
              <div class:list={["overflow-hidden", heroImageRounded && "rounded-xl"]}>
                {heroImage ? (
                  hasImageLightbox ? (
                    <button
                      type="button"
                      data-lightbox-trigger
                      data-lightbox-src={heroImage}
                      data-lightbox-alt={title}
                      class="block w-full cursor-pointer"
                    >
                      <img src={heroImage} alt={title} class="w-full object-cover" />
                    </button>
                  ) : (
                    <img src={heroImage} alt={title} class="w-full object-cover" />
                  )
                ) : (
                  <div class="flex aspect-4/3 items-center justify-center border border-dashed border-white/15 bg-white/5 text-xs text-muted-foreground">
                    Image coming soon
                  </div>
                )}
              </div>
            </div>

            <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-4 border-t border-border py-6 text-sm sm:grid-cols-4">
              <div>
                <dt class="text-muted-foreground">Company</dt>
                <dd class="mt-1">
                  {companyUrl ? (
                    <a
                      href={companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 transition-opacity hover:opacity-80"
                    >
                      {company}
                      <ArrowUpRight className="size-3.5 shrink-0" />
                    </a>
                  ) : (
                    company
                  )}
                </dd>
              </div>
              <div>
                <dt class="text-muted-foreground">Role</dt>
                <dd class="mt-1">{role}</dd>
              </div>
              <div>
                <dt class="text-muted-foreground">Industry</dt>
                <dd class="mt-1">{industry}</dd>
              </div>
              <div>
                <dt class="text-muted-foreground">Timeframe</dt>
                <dd class="mt-1">{timeframe}</dd>
              </div>
            </dl>
          </div>
        </div>

        <div id="content-zone" style={contentStyle} class="w-full bg-background text-foreground">
          <div class="mx-auto flex w-full max-w-5xl flex-col gap-24 px-6 py-16 sm:px-8">
            {problem && (
              <div id="problem" data-reveal data-reveal-group class={rowClass}>
                <p class={labelClass}>The Problem</p>
                <div class="flex flex-col gap-5">
                  <p class="text-base leading-relaxed text-muted-foreground">{problem.intro}</p>
                  {problem.points && problem.points.length > 0 && (
                    <ul class="flex list-disc flex-col gap-3 pl-5 marker:text-muted-foreground">
                      {problem.points.map((point) => (
                        <li class="text-base leading-relaxed text-muted-foreground">{point}</li>
                      ))}
                    </ul>
                  )}
                  {problem.closing && (
                    <p class="text-base leading-relaxed text-muted-foreground">{problem.closing}</p>
                  )}
                  {problem.challenges && problem.challenges.length > 0 && (
                    <div class="flex flex-col gap-3">
                      <p class="text-sm font-medium text-foreground">Key challenges</p>
                      <ol class="flex list-decimal flex-col gap-3 pl-5 marker:text-muted-foreground">
                        {problem.challenges.map((challenge) => (
                          <li class="text-base leading-relaxed text-muted-foreground">{challenge}</li>
                        ))}
                      </ol>
                    </div>
                  )}
                  {problem.stakes && (
                    <p class="border-l-2 border-accent pl-6 text-xl leading-relaxed font-medium text-foreground">
                      {problem.stakes}
                    </p>
                  )}
                </div>
              </div>
            )}

            {approachItems && approachItems.length > 0 && (
              <div id="approach" data-reveal data-reveal-group class={rowClass}>
                <p class={labelClass}>Approach</p>
                <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
                  {approachItems.map((item) => {
                    const Icon = approachIcons[item.icon]
                    return (
                      <div class="flex flex-col gap-2">
                        <Icon className="size-5 text-foreground" strokeWidth={1.5} />
                        <p class="text-lg font-medium text-foreground">{item.title}</p>
                        <p class="text-base leading-relaxed text-muted-foreground">
                          {item.description}
                        </p>
                      </div>
                    )
                  })}
                </div>
              </div>
            )}

            {solutionSections && solutionSections.length > 0 && (
              <div id="solutions" data-reveal data-reveal-group class={rowClass}>
                <p class={labelClass}>Solutions</p>
                <div class="flex flex-col gap-16">
                  {solutionSections.map((section) => (
                    <CaseStudySection
                      heading={section.heading}
                      body={section.body}
                      image={section.image}
                      images={section.images}
                      imagePosition={section.imagePosition}
                      link={section.link}
                      visual={section.visual}
                      beforeAfter={section.beforeAfter}
                    />
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>

        {(highlights?.length || testimonial || ctaHeading) && (
          <div style={heroStyle} class="w-full bg-background text-foreground">
            <div data-reveal-group class="mx-auto flex w-full max-w-5xl flex-col gap-16 px-6 py-16 sm:px-8">
              {highlights && highlights.length > 0 && (
                <div id="impact" data-reveal class={rowClass}>
                  <p class={`${labelClass} !text-accent`}>Impact</p>
                  <ul class="flex flex-col gap-6">
                    {highlights.map((item) => (
                      <li class="flex items-start gap-4">
                        <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" />
                        <span class="text-lg leading-relaxed">
                          {splitHighlight(item).map((part) =>
                            part.emphasis ? <span class="text-accent">{part.text}</span> : part.text
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {testimonial && (
                <div data-reveal class="rounded-2xl bg-card px-8 py-10 sm:px-10">
                  <p class="text-lg leading-relaxed sm:text-xl">&ldquo;{testimonial.quote}&rdquo;</p>
                  {testimonial.linkedin ? (
                    <a
                      href={testimonial.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group mt-6 flex items-center gap-3"
                    >
                      {testimonial.avatar && (
                        <img
                          src={testimonial.avatar}
                          alt={testimonial.author}
                          class="size-10 rounded-full object-cover"
                        />
                      )}
                      <p class="text-sm text-muted-foreground transition-colors group-hover:text-foreground">
                        <span class="underline-offset-2 group-hover:underline">
                          {testimonial.author}
                        </span>{" "}
                        - {testimonial.role}
                      </p>
                    </a>
                  ) : (
                    <div class="mt-6 flex items-center gap-3">
                      {testimonial.avatar && (
                        <img
                          src={testimonial.avatar}
                          alt={testimonial.author}
                          class="size-10 rounded-full object-cover"
                        />
                      )}
                      <p class="text-sm text-muted-foreground">
                        {testimonial.author} - {testimonial.role}
                      </p>
                    </div>
                  )}
                </div>
              )}

              {ctaHeading && (
                <div data-reveal class="flex flex-col gap-4">
                  <p class="text-2xl font-semibold text-[var(--cta-foreground)]">{ctaHeading}</p>
                  <div class="flex flex-wrap gap-3">
                    <a
                      href="https://www.linkedin.com/in/gilvega/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
                    >
                      <Linkedin className="size-4" />
                      LinkedIn
                    </a>
                    <button
                      type="button"
                      data-copy-email="gilberthvg@gmail.com"
                      class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
                    >
                      <Copy className="size-4" />
                      <span data-copy-label>Email</span>
                    </button>
                  </div>
                </div>
              )}

              <slot />
            </div>
          </div>
        )}

        {navItems.length > 0 && (
          <nav
            id="case-study-nav"
            aria-label="Case study sections"
            style={{ "--nav-color": "#ffffff", transition: "color 0.3s ease" }}
            class="hidden lg:fixed lg:top-1/2 lg:left-8 lg:z-10 lg:flex lg:w-36 lg:-translate-y-1/2 lg:flex-col lg:gap-3"
          >
            {navItems.map((item) => (
              <a
                href={`#${item.id}`}
                data-nav-link={item.id}
                class="text-[var(--nav-color)] text-sm opacity-70 transition-opacity hover:opacity-100 data-[active=true]:font-medium data-[active=true]:opacity-100"
              >
                {item.label}
              </a>
            ))}
          </nav>
        )}

        <script>
          function initCaseStudyNav() {
            const nav = document.getElementById("case-study-nav")
            if (!nav) return
            const links = Array.from(nav.querySelectorAll("[data-nav-link]"))
            const sections = links
              .map((link) => document.getElementById(link.getAttribute("data-nav-link") ?? ""))
              .filter((el): el is HTMLElement => Boolean(el))

            function setActive(id: string) {
              links.forEach((link) => {
                link.setAttribute(
                  "data-active",
                  String(link.getAttribute("data-nav-link") === id)
                )
              })
            }

            const observer = new IntersectionObserver(
              (entries) => {
                const visible = entries.filter((entry) => entry.isIntersecting)
                if (visible.length === 0) return
                const topMost = visible.sort(
                  (a, b) => a.boundingClientRect.top - b.boundingClientRect.top
                )[0]
                setActive(topMost.target.id)
              },
              { rootMargin: "-20% 0px -70% 0px" }
            )
            sections.forEach((section) => observer.observe(section))

            // The nav is fixed at the vertical center of the viewport, so it
            // drifts over both the always-purple hero/impact sections and
            // the content zone (which follows the light/dark toggle). A
            // single static color can't stay legible against both, so we
            // watch whether the content zone currently covers the nav's
            // position and switch between a fixed light color (for the
            // purple sections) and the toggle-aware surface color.
            const contentZone = document.getElementById("content-zone")
            if (contentZone) {
              const zoneObserver = new IntersectionObserver(
                ([entry]) => {
                  nav.style.setProperty(
                    "--nav-color",
                    entry.isIntersecting ? "var(--surface-foreground)" : "#ffffff"
                  )
                },
                { rootMargin: "-50% 0px -50% 0px" }
              )
              zoneObserver.observe(contentZone)
            }
          }

          function initCopyEmail() {
            const buttons = document.querySelectorAll<HTMLButtonElement>("main [data-copy-email]")
            buttons.forEach((button) => {
              const label = button.querySelector("[data-copy-label]")
              if (!label) return
              const defaultLabel = label.textContent

              button.addEventListener("click", async () => {
                const email = button.getAttribute("data-copy-email") ?? ""
                try {
                  await navigator.clipboard.writeText(email)
                  label.textContent = "Copied!"
                  setTimeout(() => {
                    label.textContent = defaultLabel
                  }, 1800)
                } catch {
                  // Clipboard API unavailable — no-op, button still shows the email intent.
                }
              })
            })
          }

          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => {
              initCaseStudyNav()
              initCopyEmail()
            })
          } else {
            initCaseStudyNav()
            initCopyEmail()
          }
        </script>
      </article>
    ) : (
      <article class="mx-auto w-full max-w-4xl px-6 py-12 sm:px-8">
        <a
          href="/#work"
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          &larr; Back to work
        </a>

        <header class="mt-6 flex flex-col gap-6">
          <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            {title}
          </h1>
          <p class="max-w-2xl text-lg text-muted-foreground">{description}</p>

          <dl class="grid grid-cols-2 gap-x-8 gap-y-4 border-y border-border py-6 text-sm sm:grid-cols-4">
            <div>
              <dt class="text-muted-foreground">Company</dt>
              <dd class="mt-1 text-foreground">
                {companyUrl ? (
                  <a
                    href={companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 transition-opacity hover:opacity-80"
                  >
                    {company}
                    <ArrowUpRight className="size-3.5 shrink-0" />
                  </a>
                ) : (
                  company
                )}
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Role</dt>
              <dd class="mt-1 text-foreground">{role}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Industry</dt>
              <dd class="mt-1 text-foreground">{industry}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Timeframe</dt>
              <dd class="mt-1 text-foreground">{timeframe}</dd>
            </div>
          </dl>

          <div class="flex flex-wrap gap-1.5">
            {skills.map((skill) => <Badge variant="secondary">{skill}</Badge>)}
          </div>
        </header>

        <div class="mt-10 overflow-hidden rounded-xl bg-muted">
          <img src={heroImage} alt={title} class="w-full object-cover" />
        </div>

        <div class="prose mx-auto mt-12">
          <slot />
        </div>
      </article>
    )
  }

  {
    hasImageLightbox && (
      <>
        <div id="image-lightbox" data-lightbox-overlay aria-hidden="true">
          <div class="lightbox-content">
            <button type="button" data-lightbox-close class="lightbox-close-btn">
              <X className="size-4" />
              Close
            </button>
            <img data-lightbox-image src="" alt="" />
          </div>
        </div>
        <span data-lightbox-cursor-tag aria-hidden="true">
          Click to expand
        </span>
      </>
    )
  }
</BaseLayout>

<style>
  #page-curtain {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: linear-gradient(180deg, var(--background) 0%, var(--background) 92%, transparent 100%);
    pointer-events: none;
    animation: curtain-up 0.65s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes curtain-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #page-curtain {
      display: none;
    }
  }

  #image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklch, black 70%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }
  #image-lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    max-width: 60vw;
    transform: scale(0.96);
    transition: transform 0.25s ease;
  }
  #image-lightbox.is-open .lightbox-content {
    transform: scale(1);
  }
  .lightbox-content img {
    max-width: 60vw;
    max-height: 60vh;
    width: auto;
    height: auto;
    border-radius: 0.75rem;
    object-fit: contain;
    box-shadow: 0 25px 60px -15px rgb(0 0 0 / 0.5);
  }
  .lightbox-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    background: white;
    color: black;
    font-size: 0.8rem;
    font-weight: 500;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
    transition: opacity 0.15s ease;
  }
  .lightbox-close-btn:hover {
    opacity: 0.85;
  }
</style>

<style is:global>
  [data-lightbox-cursor-tag] {
    position: fixed;
    z-index: 300;
    pointer-events: none;
    background: black;
    color: white;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    opacity: 0;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }
  [data-lightbox-cursor-tag].is-visible {
    opacity: 1;
  }
</style>

<script>
  function initImageLightbox() {
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")
    if (!triggers.length) return

    const overlay = document.querySelector<HTMLDivElement>("[data-lightbox-overlay]")
    const image = document.querySelector<HTMLImageElement>("[data-lightbox-image]")
    const closeButton = document.querySelector<HTMLButtonElement>("[data-lightbox-close]")
    const cursorTag = document.querySelector<HTMLSpanElement>("[data-lightbox-cursor-tag]")
    if (!overlay || !image || !closeButton) return

    function open(src: string, alt: string) {
      image!.src = src
      image!.alt = alt
      overlay!.classList.add("is-open")
      document.body.style.overflow = "hidden"
    }

    function close() {
      overlay!.classList.remove("is-open")
      document.body.style.overflow = ""
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const src = trigger.getAttribute("data-lightbox-src") ?? ""
        const alt = trigger.getAttribute("data-lightbox-alt") ?? ""
        open(src, alt)
      })

      if (cursorTag) {
        trigger.addEventListener("mouseenter", () => cursorTag.classList.add("is-visible"))
        trigger.addEventListener("mouseleave", () => cursorTag.classList.remove("is-visible"))
        trigger.addEventListener("mousemove", (e) => {
          cursorTag.style.left = `${e.clientX + 16}px`
          cursorTag.style.top = `${e.clientY + 16}px`
        })
      }
    })

    closeButton.addEventListener("click", close)
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close()
    })
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close()
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initImageLightbox)
  } else {
    initImageLightbox()
  }
</script>
