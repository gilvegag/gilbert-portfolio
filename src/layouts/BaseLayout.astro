---
import Header from "@/components/layout/Header.astro"
import Footer from "@/components/layout/Footer.astro"
import "@/styles/global.css"

interface Props {
  title: string
  description: string
  themeVars?: Record<string, string>
  // Applied to <body> instead of a page-section background, so anything
  // that sits transparent above the normal --background (the header, a
  // case study's brand-colored hero/footer sections, the site footer)
  // shows this through continuously instead of each painting its own
  // separate, seam-prone copy of it. See ProjectLayout.astro.
  bodyStyle?: Record<string, string>
}

const { title, description, themeVars, bodyStyle } = Astro.props
const themeStyle = themeVars
  ? Object.entries(themeVars)
      .map(([key, value]) => `${key}:${value}`)
      .join(";")
  : undefined
const bodyStyleStr = bodyStyle
  ? Object.entries(bodyStyle)
      .map(([key, value]) => `${key}:${value}`)
      .join(";")
  : undefined
---

<!doctype html>
<html lang="en" class="dark scroll-smooth" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/images/home/favicon.svg" />
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="7a902904-12ab-4d1c-a660-90a414e60eee"></script>
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (stored === "light") {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body style={bodyStyleStr}>
    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import "@/scripts/reveal.ts"
    </script>
  </body>
</html>
