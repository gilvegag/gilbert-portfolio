---
// Alternate home layout trial — case study cards laid out image-left/
// text-right (inspired by lab.auth0.com's experiments list) instead of the
// 3-column grid on the real home page. Not linked from nav; visit directly
// to compare. Delete this file (and the "landscape" ProjectCard variant)
// once a direction is picked, or promote it to replace index.astro.
import { getCollection } from "astro:content"
import { Figma, Rocket } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import { Badge } from "@/components/ui/badge"

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
)

const cardStats: Record<string, { statLine: string; secondaryTag?: string }> = {
  "accuray-radiotherapy": { statLine: "25% faster workflow", secondaryTag: "B2B Healthtech" },
  oatfi: { statLine: "10+ deals closed", secondaryTag: "Fintech · 0→1 product" },
  "accuray-design-system": { statLine: "90% coverage" },
}
---

<BaseLayout
  title="Gilbert Vega — Senior Product Designer"
  description="Senior Product Designer with 12+ years of experience across B2B SaaS, fintech, healthcare, and design systems."
>
  <section
    data-reveal-group
    class="mx-auto flex w-full max-w-[1400px] flex-col gap-8 px-6 py-8 sm:px-8 lg:flex-row lg:items-center lg:justify-start lg:gap-20 lg:px-14 lg:py-12"
  >
    <div
      data-reveal
      class="w-40 shrink-0 self-center overflow-hidden rounded-xl ring-1 ring-foreground/10 lg:w-56 lg:self-auto xl:w-64"
    >
      <img
        src="/images/home/profilenew.png"
        alt="Gilbert Vega"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
    <div class="flex max-w-4xl flex-col gap-4">
      <p
        data-reveal
        class="text-xs font-medium text-balance tracking-[0.1em] text-muted-foreground uppercase"
      >
        Senior Product Designer / Design Engineer
      </p>
      <h1
        data-reveal
        class="text-3xl leading-tight font-medium tracking-tight text-balance text-foreground sm:text-4xl lg:text-4xl"
      >
        I design complex product workflows
        <br class="hidden lg:block" />
        and turn them into clear, shippable systems.
      </h1>
      <p data-reveal class="max-w-[70ch] text-base leading-normal text-pretty text-foreground">
        I help technical teams turn complex or ambiguous problems into
        scalable products, bridging design intent and frontend
        implementation, whether that's building zero-to-one or evolving what
        already exists.
      </p>
      <p data-reveal class="max-w-[75ch] text-sm leading-normal text-pretty text-muted-foreground">
        Over 12 years in design, working up to senior and lead roles on
        regulated healthtech and fintech products, where user flows are
        complex, engineering constraints are real, and someone needs to make
        the product understandable, usable, and scalable. I started in
        frontend and visual design before moving into product design, and
        that foundation still grounds how I think about design and code
        together.
      </p>
      <div data-reveal class="flex flex-wrap gap-2">
        <Badge variant="secondary">Design systems at scale</Badge>
        <Badge variant="secondary">Regulated healthtech and fintech</Badge>
        <Badge variant="secondary">Zero-to-one Lead UX</Badge>
      </div>
    </div>
  </section>

  <section
    id="work"
    data-reveal-group
    class="mx-auto w-full max-w-[1400px] px-6 pt-8 pb-24 sm:px-8 lg:px-14 lg:pt-16"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      Selected Work
    </p>
    <div class="flex flex-col gap-4">
      {projects.map((project) => {
        const stat = cardStats[project.slug]
        return stat ? (
          <ProjectCard
            project={project}
            variant="landscape"
            statLine={stat.statLine}
            secondaryTag={stat.secondaryTag}
          />
        ) : (
          <ProjectCard project={project} variant="landscape" />
        )
      })}
    </div>
  </section>

  <section class="mx-auto w-full max-w-[1400px] px-6 pb-16 sm:px-8 lg:px-14">
    <div
      data-reveal
      class="flex flex-col items-center gap-8 border-t border-border pt-12 text-center"
    >
      <p class="max-w-2xl text-base leading-snug font-normal tracking-tight text-foreground sm:text-lg lg:text-xl">
        Designed in Figma. Built with Astro and Claude Code.
      </p>
      <div class="flex items-center gap-6 text-muted-foreground">
        <Figma aria-label="Figma" className="size-5" strokeWidth={1.5} />
        <Rocket aria-label="Astro" className="size-5" strokeWidth={1.5} />
        <span
          role="img"
          aria-label="Claude Code"
          class="inline-block size-5 bg-current"
          style="mask-image:url(/images/logos/claude.png); -webkit-mask-image:url(/images/logos/claude.png); mask-size:contain; -webkit-mask-size:contain; mask-repeat:no-repeat; -webkit-mask-repeat:no-repeat; mask-position:center; -webkit-mask-position:center;"
        />
      </div>
    </div>
  </section>

  <span data-hover-tag aria-hidden="true"></span>
</BaseLayout>

<style>
  [data-hover-tag] {
    position: fixed;
    z-index: 300;
    pointer-events: none;
    background: black;
    color: white;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    opacity: 0;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }
  [data-hover-tag].is-visible {
    opacity: 1;
  }
</style>

<script>
  function initHoverTags() {
    const tag = document.querySelector<HTMLSpanElement>("[data-hover-tag]")
    if (!tag) return

    function attach(elements: NodeListOf<HTMLElement>, label: string) {
      elements.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          tag!.textContent = label
          tag!.classList.add("is-visible")
        })
        el.addEventListener("mouseleave", () => tag!.classList.remove("is-visible"))
        el.addEventListener("mousemove", (e) => {
          tag!.style.left = `${e.clientX + 16}px`
          tag!.style.top = `${e.clientY + 16}px`
        })
      })
    }

    attach(document.querySelectorAll<HTMLElement>("#work a"), "View")
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHoverTags)
  } else {
    initHoverTags()
  }
</script>
