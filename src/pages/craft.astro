---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { craftPieces, craftStatement, craftIntro } from "@/data/craft"

// Pre-build slide lists per piece so the template stays type-clean
type SlideVideo = { kind: "video"; src: string; label: string; autoplay: boolean }
type SlideBA    = { kind: "ba";    before: string; after: string; alt: string }
type SlideImg   = { kind: "img";   src: string; alt: string; orientation: string }
type Slide = SlideVideo | SlideBA | SlideImg

const pieceSlides: Slide[][] = craftPieces.map((piece, pi) => {
  // phoneSpread / sideBySide pieces skip the slide system entirely
  if (piece.phoneSpread || piece.sideBySide) return []
  const slides: Slide[] = []
  if (piece.video) {
    slides.push({ kind: "video", src: piece.video.src, label: piece.video.label, autoplay: pi === 0 })
  }
  for (const pair of piece.beforeAfterPairs ?? []) {
    slides.push({ kind: "ba", before: pair.before, after: pair.after, alt: pair.alt ?? "" })
  }
  const ordered = [
    ...piece.images.filter(img => img.orientation === "desktop"),
    ...piece.images.filter(img => img.orientation === "mobile"),
  ]
  for (const img of ordered) {
    slides.push({ kind: "img", src: img.src, alt: img.alt, orientation: img.orientation })
  }
  return slides
})
---

<BaseLayout
  title="Craft — Gilbert Vega"
  description="Selected interface and brand work: product UI, booking flows, and brand-led launches where type, color, and hierarchy carry the product."
>
  <!-- Hero — same sizing and position as case study pages -->
  <div class="craft-hero-section mx-auto w-full max-w-[1128px] px-6 pt-4 pb-3 sm:px-8 lg:px-14">
    <a href="/#work" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
      ← Back to work
    </a>
    <h1 class="mt-4 max-w-[36ch] text-3xl font-semibold text-pretty tracking-tight text-foreground sm:text-4xl">
      {craftStatement}
    </h1>
    <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-muted-foreground">
      {craftIntro}
    </p>
  </div>

  <div class="craft-root mb-16 sm:mb-24 mt-5 sm:mt-7">

    <!-- Browser shell -->
    <div class="craft-browser">

      <!-- Chrome: traffic lights + tabs -->
      <div class="craft-chrome">
<div class="craft-tab-strip" role="tablist">
          {craftPieces.map((piece, i) => (
            <button
              class:list={["craft-tab", i === 0 && "is-active"]}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-tab-btn={i}
            >
              {piece.favicon && (
                <img src={piece.favicon} alt="" aria-hidden="true" class="tab-favicon" width="14" height="14" />
              )}
              <span class="tab-title">{piece.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Viewport: one panel per piece -->
      <div class="craft-viewport">
        {craftPieces.map((piece, i) => (
          <div
            class:list={["craft-panel", i === 0 && "is-active"]}
            role="tabpanel"
            data-tab-panel={i}
          >

            <!-- Top: project info header -->
            <div class="panel-header">
              <div class="panel-header-inner">
                <div class="panel-title-row">
                  <h2 class="panel-name">{piece.name}</h2>
                  <span class="panel-kind">{piece.kind}</span>
                </div>
                <p class="panel-note">{piece.note}</p>
              </div>
            </div>

            <!-- Bottom: visual area -->
            <div class="panel-visual" style={piece.panelBg ? { backgroundImage: piece.panelBg } : undefined}>
              {piece.phoneSpread ? (
                <div class="phone-spread">
                  {piece.images.map((img) => (
                    <img src={img.src} alt={img.alt} class="phone-spread-img" loading="eager" />
                  ))}
                </div>
              ) : piece.sideBySide ? (
                <div class="side-by-side-wrap">
                  {piece.images.map((img) => (
                    <img
                      src={img.src}
                      alt={img.alt}
                      class:list={["side-by-side-img", img.orientation === "mobile" ? "side-by-side-mobile" : "side-by-side-desktop"]}
                      loading="eager"
                    />
                  ))}
                </div>
              ) : (() => {
                const slides = pieceSlides[i]
                const hasMany = slides.length > 1
                const hasBa = slides.some(s => s.kind === "ba")
                const firstIsBa = slides[0]?.kind === "ba"
                return (
                  <>
                  <div class:list={["panel-slides", hasMany && "has-carousel"]} data-slides>
                    {slides.map((slide, si) => {
                      if (slide.kind === "video") return (
                        <div class:list={["panel-slide", si === 0 && "is-active"]} data-slide>
                          <video
                            src={slide.src}
                            aria-label={slide.label}
                            class="panel-video"
                            data-autoplay={slide.autoplay ? "" : undefined}
                            muted loop playsinline preload="none"
                          />
                        </div>
                      )
                      if (slide.kind === "ba") return (
                        <div class:list={["panel-slide ba-slide", si === 0 && "is-active"]} data-slide data-ba-slide>
                          <div class="ba-wrap" data-ba-wrap aria-label={slide.alt}>
                            <img src={slide.after}  class="ba-img ba-after"  alt="After"  loading="lazy" />
                            <img src={slide.before} class="ba-img ba-before" alt="Before" loading="lazy" data-ba-before />
                            <div class="ba-divider" data-ba-divider style="left:50%">
                              <div class="ba-handle">⇔</div>
                            </div>
                          </div>
                        </div>
                      )
                      // img
                      return (
                        <div
                          class:list={["panel-slide", slide.orientation === "mobile" && "phone-slide", si === 0 && "is-active"]}
                          data-slide
                        >
                          <img
                            src={slide.src}
                            alt={slide.alt}
                            class={slide.orientation === "mobile" ? "slide-phone-img" : "slide-desktop-img"}
                            loading={si === 0 ? "eager" : "lazy"}
                          />
                        </div>
                      )
                    })}
                    {hasMany && (
                      <>
                        <button class="slide-arrow slide-prev" data-prev aria-label="Previous">←</button>
                        <button class="slide-arrow slide-next" data-next aria-label="Next">→</button>
                        <div class="slide-dots" data-dots>
                          {hasBa && (
                            <span class="ba-label ba-label-l" data-ba-label aria-hidden="true" hidden={!firstIsBa}>Before</span>
                          )}
                          {slides.map((_, di) => (
                            <button
                              class:list={["slide-dot", di === 0 && "is-active"]}
                              data-dot={di}
                              aria-label={`Slide ${di + 1}`}
                            />
                          ))}
                          {hasBa && (
                            <span class="ba-label ba-label-r" data-ba-label aria-hidden="true" hidden={!firstIsBa}>After</span>
                          )}
                        </div>
                      </>
                    )}
                  </div>
                  </>
                )
              })()}
            </div>


          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* ── Root (browser shell only — hero lives above this) ── */
  .craft-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1128px;
    margin-inline: auto;
    padding-inline: 1.5rem;   /* px-6 */
  }
  @media (min-width: 640px)  { .craft-root { padding-inline: 2rem; } }   /* sm:px-8 */
  @media (min-width: 1024px) { .craft-root { padding-inline: 3.5rem; } } /* lg:px-14 */

  /* ── Browser shell ── */
  .craft-browser {
    display: flex;
    flex-direction: column;
  }

  /* ── Chrome bar ── */
  .craft-chrome {
    display: flex;
    align-items: flex-end; /* tabs sit flush at the bottom of the chrome */
    height: 44px;
    padding: 0 0.5rem;
    background-color: transparent;
    flex-shrink: 0;
    gap: 0;
  }

/* Tab strip */
  .craft-tab-strip {
    display: flex;
    align-items: flex-end;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .craft-tab-strip::-webkit-scrollbar { display: none; }

  /* Individual tabs */
  .craft-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0.875rem;
    height: 34px; /* sits at bottom of 44px chrome, leaving 10px gap at top */
    background: oklch(from var(--background) calc(l + 0.02) c h);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-family: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
    position: relative;
    margin-right: 2px;
  }

  .craft-tab.is-active {
    background: var(--background);
    color: var(--foreground);
    border-color: var(--border);
  }
  /* Covers the viewport's top border segment beneath the active tab */
  .craft-tab.is-active::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--background);
  }

  .tab-favicon {
    width: 14px;
    height: 14px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 2px;
  }
  .tab-title {
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Viewport ── */
  .craft-viewport {
    position: relative;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  /* ── Panels ── */
  .craft-panel {
    display: none;
    flex-direction: column;
  }
  .craft-panel.is-active { display: flex; }

  /* ── Panel header (info) — fixed height so all tabs have equal visual area ── */
  .panel-header {
    flex-shrink: 0;
    border-bottom: 1px solid var(--border);
  }
  .panel-header-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1.5rem;
  }
  @media (min-width: 640px) { .panel-header-inner { padding: 0.875rem 2rem; } }

  .panel-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0;
    color: var(--foreground);
  }
  @media (min-width: 640px) { .panel-name { font-size: 1.125rem; } }

  .panel-kind {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted-foreground);
    white-space: nowrap;
    flex-shrink: 0;
    text-align: right;
  }

  .panel-note {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--muted-foreground);
    margin: 0;
    max-width: 72ch;
  }

  /* ── Panel visual (bottom) ── */
  .panel-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.5rem;
    height: 56vh;
    background-color: oklch(from var(--background) calc(l - 0.02) c h);
    overflow: hidden;
    position: relative;
  }
  @media (min-width: 640px) { .panel-visual { padding: 2rem 2.5rem; } }
  @media (min-width: 1024px) { .panel-visual { padding: 2.5rem 4rem; } }

  /* Video */
  .panel-video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: 100%;
    border-radius: 0.75rem;
    display: block;
    object-fit: contain;
  }

  /* ── Image slides ── */
  .panel-slides {
    width: 100%;
    max-width: 820px;
    position: relative;
    height: 44vh;
  }

  .panel-slide { display: none; }
  .panel-slide.is-active { display: flex; justify-content: center; align-items: center; height: 100%; }

  .slide-desktop-img {
    width: 100%;
    height: auto;
    max-height: 50vh;
    object-fit: contain;
    border-radius: 0.75rem;
    box-shadow: 0 24px 64px rgba(0,0,0,0.55);
    display: block;
  }

  .slide-phone-img {
    height: min(52vh, 400px);
    width: auto;
    border-radius: 0.75rem;
    box-shadow: 0 12px 40px rgba(0,0,0,0.45);
    display: block;
  }

  /* ── Phone spread (side-by-side phones) ── */
  .phone-spread {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
  }
  .phone-spread-img {
    height: min(48vh, 380px);
    width: auto;
    border-radius: 1rem;
    box-shadow: 0 16px 48px rgba(0,0,0,0.18);
    display: block;
    flex-shrink: 0;
  }
  /* Slight vertical offset for visual rhythm */
  .phone-spread-img:nth-child(1) { transform: translateY(0.75rem); }
  .phone-spread-img:nth-child(2) { transform: translateY(-0.5rem); }
  .phone-spread-img:nth-child(3) { transform: translateY(0.75rem); }

  /* ── Side-by-side (desktop + mobile) ── */
  .side-by-side-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }
  .side-by-side-desktop {
    height: min(52vh, 420px);
    width: auto;
    border-radius: 0.5rem;
    box-shadow: 0 16px 48px rgba(0,0,0,0.18);
    object-fit: contain;
    flex-shrink: 1;
    max-width: 72%;
  }
  .side-by-side-mobile {
    height: min(48vh, 380px);
    width: auto;
    border-radius: 1rem;
    box-shadow: 0 16px 48px rgba(0,0,0,0.18);
    object-fit: contain;
    flex-shrink: 0;
  }

  /* ── Before/After slider ── */
  .ba-wrap {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 5/4;
    max-height: 100%;
    cursor: col-resize;
    user-select: none;
    touch-action: none;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  /* Both images fill the wrapper exactly — same width, same height */
  .ba-after,
  .ba-before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  /* Before is clipped from the right, revealing after behind it */
  .ba-before {
    clip-path: inset(0 50% 0 0); /* JS updates this */
  }
  .ba-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: white;
    transform: translateX(-50%);
    pointer-events: none;
    box-shadow: 0 0 8px rgba(0,0,0,0.35);
  }
  .ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: white;
    color: #111;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    pointer-events: none;
    cursor: col-resize;
  }
  /* BA labels — sit inside the dots row, one at each edge */
  .ba-label {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    background: rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.75);
    pointer-events: none;
    white-space: nowrap;
  }
  .ba-label[hidden] { display: none; }
  .ba-label-l { left: 0; }
  .ba-label-r { right: 0; }

  /* Carousel arrows */
  /* Arrows and dots always light — panel backgrounds are always dark */
  .slide-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.3);
    background: transparent;
    color: rgba(255,255,255,0.85);
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.15s;
    user-select: none;
  }
  .slide-arrow:hover { background-color: rgba(255,255,255,0.12); }
  .slide-prev { left: -4.5rem; }
  .slide-next { right: -4.5rem; }
  @media (max-width: 640px) {
    .slide-prev { left: -1.5rem; }
    .slide-next { right: -1.5rem; }
  }

  /* Carousel dots */
  .slide-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    position: relative;
  }
  .slide-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.25);
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
    padding: 0;
  }
  .slide-dot.is-active {
    background: rgba(255,255,255,0.9);
    transform: scale(1.35);
  }
</style>

<script>
  function init() {
    const tabBtns = document.querySelectorAll<HTMLElement>("[data-tab-btn]")
    const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]")

    function activateTab(idx: number) {
      tabBtns.forEach((btn, i) => {
        btn.classList.toggle("is-active", i === idx)
        btn.setAttribute("aria-selected", i === idx ? "true" : "false")
      })
      panels.forEach((panel, i) => panel.classList.toggle("is-active", i === idx))

      document.querySelectorAll<HTMLVideoElement>(".panel-video").forEach(v => v.pause())
      const vid = panels[idx]?.querySelector<HTMLVideoElement>(".panel-video")
      if (vid) vid.play().catch(() => {})
    }

    tabBtns.forEach((btn, i) => btn.addEventListener("click", () => activateTab(i)))

    // Autoplay first video
    document.querySelector<HTMLVideoElement>("[data-autoplay]")?.play().catch(() => {})

    // Per-panel image carousels
    panels.forEach((panel) => {
      const wrap = panel.querySelector<HTMLElement>("[data-slides]")
      if (!wrap?.classList.contains("has-carousel")) return

      const slides = Array.from(wrap.querySelectorAll<HTMLElement>("[data-slide]"))
      const dots = Array.from(wrap.querySelectorAll<HTMLElement>("[data-dot]"))
      let cur = 0

      const baLabels = Array.from(panel.querySelectorAll<HTMLElement>("[data-ba-label]"))

      function goTo(n: number) {
        slides[cur].classList.remove("is-active")
        dots[cur]?.classList.remove("is-active")
        cur = (n + slides.length) % slides.length
        slides[cur].classList.add("is-active")
        dots[cur]?.classList.add("is-active")
        // Resume video if navigating back to it
        const vid = slides[cur].querySelector<HTMLVideoElement>("video")
        if (vid) vid.play().catch(() => {})
        // Show BA labels only on BA slides
        const isBA = "baSlide" in slides[cur].dataset
        baLabels.forEach(label => label.toggleAttribute("hidden", !isBA))
      }

      wrap.querySelector("[data-prev]")?.addEventListener("click", () => goTo(cur - 1))
      wrap.querySelector("[data-next]")?.addEventListener("click", () => goTo(cur + 1))
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)))
    })

    // Before/After drag sliders
    document.querySelectorAll<HTMLElement>("[data-ba-wrap]").forEach((baWrap) => {
      if (baWrap.dataset.baInit) return
      baWrap.dataset.baInit = "1"
      const beforeImg = baWrap.querySelector<HTMLElement>("[data-ba-before]")!
      const divider   = baWrap.querySelector<HTMLElement>("[data-ba-divider]")!

      function move(clientX: number) {
        const rect = baWrap.getBoundingClientRect()
        if (!rect.width) return
        const pct = Math.max(2, Math.min(98, ((clientX - rect.left) / rect.width) * 100))
        beforeImg.style.clipPath = `inset(0 ${100 - pct}% 0 0)`
        divider.style.left = pct + "%"
      }

      baWrap.addEventListener("mousedown", (e) => {
        e.preventDefault()
        move(e.clientX)
        const onMove = (e: MouseEvent) => move(e.clientX)
        const onUp = () => {
          document.removeEventListener("mousemove", onMove)
          document.removeEventListener("mouseup", onUp)
        }
        document.addEventListener("mousemove", onMove)
        document.addEventListener("mouseup", onUp)
      })

      baWrap.addEventListener("touchstart", (e) => {
        move(e.touches[0].clientX)
        const onMove = (e: TouchEvent) => move(e.touches[0].clientX)
        const onEnd = () => {
          document.removeEventListener("touchmove", onMove as EventListener)
          document.removeEventListener("touchend", onEnd)
        }
        document.addEventListener("touchmove", onMove as EventListener, { passive: true })
        document.addEventListener("touchend", onEnd)
      }, { passive: true })
    })

    // Arrow keys switch tabs
    document.addEventListener("keydown", (e) => {
      const cur = Array.from(tabBtns).findIndex(b => b.classList.contains("is-active"))
      if (e.key === "ArrowLeft" && cur > 0) activateTab(cur - 1)
      if (e.key === "ArrowRight" && cur < tabBtns.length - 1) activateTab(cur + 1)
    })
  }

  document.addEventListener("DOMContentLoaded", init)
</script>
