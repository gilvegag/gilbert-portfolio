---
import { Linkedin, Copy } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { Badge } from "@/components/ui/badge"

const skills = [
  "UX Design",
  "UI Design",
  "Product Design",
  "Consulting",
  "Design Systems",
  "HTML/CSS",
  "Figma",
  "Discovery Workshops",
  "Interaction Design",
  "User Testing",
  "Usability Testing",
  "UX Research",
  "Leadership",
  "Mentoring",
  "Cursor AI",
]
---

<BaseLayout
  title="About — Gilbert Vega"
  description="Senior Product Designer with 12+ years of experience across B2B SaaS, fintech, healthcare, and design systems."
>
  <section data-reveal-group class="mx-auto w-full max-w-5xl px-6 py-8 sm:px-8">
    <a href="/" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
      &larr; Back to home
    </a>

    <div class="mt-10 grid grid-cols-1 items-start gap-16 lg:grid-cols-[400px_1fr] lg:gap-20">

      <!-- Left: photo -->
      <div data-reveal class="lg:sticky lg:top-24 lg:self-start">
        <img
          src="/images/about/img01.png"
          alt="Gilbert Vega"
          class="w-full rounded-2xl object-cover shadow-xl"
          loading="eager"
        />
      </div>

      <!-- Right: text content -->
      <div class="flex flex-col gap-12">
        <div class="flex flex-col gap-6">
          <p class="text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">About</p>
          <div data-reveal class="flex flex-col gap-5">
            <p class="text-lg leading-relaxed text-muted-foreground">
              I've been designing since 2012. I started as a
              <strong class="font-semibold text-foreground">graphic designer, moved into front-end development, then into visual and product design</strong>.
              Over the past five years, I've focused on enterprise B2B consulting in fintech and healthcare,
              where the problems are messy, the systems are complex, and the design decisions actually matter.
            </p>
            <p class="text-lg leading-relaxed text-muted-foreground">
              That path trained me to
              <strong class="font-semibold text-foreground">think in systems and components before pixels</strong>.
              I see the full picture first, then zoom into the specific problem worth solving.
              It also made me <strong class="font-semibold text-foreground">tool-agnostic</strong>:
              when you understand the underlying patterns, picking up a new tool is just syntax.
              Right now that means applying AI to my workflow with Claude Code and Cursor,
              and I'm genuinely curious about shaping how AI shows up in products people use.
            </p>
            <p class="text-lg leading-relaxed text-muted-foreground">
              When I'm not working, you'll find me traveling, cooking, or hunting for vinyl records.
            </p>
          </div>
        </div>

        <div data-reveal class="flex flex-col gap-4">
          <h2 class="text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">Skills</h2>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => <Badge variant="secondary">{skill}</Badge>)}
          </div>
        </div>

        <div data-reveal class="flex flex-col gap-4">
          <p class="text-2xl font-semibold text-foreground">Contact me</p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://www.linkedin.com/in/gilvega/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
            >
              <Linkedin className="size-4" />
              LinkedIn
            </a>
            <button
              type="button"
              data-copy-email="gilberthvg@gmail.com"
              class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
            >
              <Copy className="size-4" />
              <span data-copy-label>Email</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("main [data-copy-email]")
    if (!button) return
    const label = button.querySelector("[data-copy-label]")
    if (!label) return
    const defaultLabel = label.textContent

    button.addEventListener("click", async () => {
      const email = button.getAttribute("data-copy-email") ?? ""
      try {
        await navigator.clipboard.writeText(email)
        label.textContent = "Copied!"
        setTimeout(() => {
          label.textContent = defaultLabel
        }, 1800)
      } catch {
        // Clipboard API unavailable — no-op, button still shows the email intent.
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyEmail)
  } else {
    initCopyEmail()
  }
</script>
