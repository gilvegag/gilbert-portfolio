---
import { Linkedin, Copy } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"
import VisualWorkCarousel from "@/components/VisualWorkCarousel.astro"
import { Badge } from "@/components/ui/badge"

const skills = [
  "UX Design",
  "UI Design",
  "Product Design",
  "Consulting",
  "Design Systems",
  "HTML/CSS",
  "Figma",
  "Discovery Workshops",
  "Interaction Design",
  "User Testing",
  "Usability Testing",
  "UX Research",
  "Leadership",
  "Mentoring",
  "Cursor AI",
]
---

<BaseLayout
  title="About — Gilbert Vega"
  description="Senior Product Designer with 12+ years of experience across B2B SaaS, fintech, healthcare, and design systems."
>
  <section data-reveal-group class="mx-auto w-full max-w-[1400px] px-6 py-8 sm:px-8 lg:px-14">
    <a href="/" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
      &larr; Back to home
    </a>

    <p class="mt-8 mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      About
    </p>
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between lg:gap-16">
      <div class="flex max-w-2xl flex-col gap-12">
        <div data-reveal class="flex flex-col gap-6">
          <p class="text-lg leading-relaxed text-muted-foreground">
            I've been designing since 2012. I started as a
            <strong class="font-semibold">graphic designer, moved into front-end development, then into
              visual and product design</strong>. Over the past five years, I've focused on enterprise
            B2B consulting in fintech and healthcare, where the problems are
            messy, the systems are complex, and the design decisions actually
            matter.
          </p>
          <p class="text-lg leading-relaxed text-muted-foreground">
            That path trained me to
            <strong class="font-semibold">think in systems and components before pixels</strong>.
            I see the full picture first, then zoom into the specific problem
            worth solving. It also made me
            <strong class="font-semibold">tool-agnostic</strong>: when you
            understand the underlying patterns, picking up a new tool is just
            syntax. Right now that means applying AI to my workflow with
            Claude Code and Cursor, and I'm genuinely curious about shaping how
            AI shows up in products people use.
          </p>
          <p class="text-lg leading-relaxed text-muted-foreground">
            I'm comfortable in ambiguity. I like being the one who finds the
            structure in it.
          </p>
        </div>

        <div data-reveal class="flex flex-col gap-4">
          <h2 class="text-sm font-medium tracking-wide text-muted-foreground uppercase">
            Skills
          </h2>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => <Badge variant="secondary">{skill}</Badge>)}
          </div>
        </div>

        <div data-reveal class="flex flex-col gap-4">
          <p class="text-2xl font-semibold text-foreground">Contact me</p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://www.linkedin.com/in/gilvega/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
            >
              <Linkedin className="size-4" />
              LinkedIn
            </a>
            <button
              type="button"
              data-copy-email="gilberthvg@gmail.com"
              class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
            >
              <Copy className="size-4" />
              <span data-copy-label>Email</span>
            </button>
          </div>
        </div>
      </div>

      <div data-reveal class="hidden w-full min-w-0 md:block lg:flex-1">
        <VisualWorkCarousel />
        <p class="mt-3 text-sm text-muted-foreground">Products I've helped build</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("main [data-copy-email]")
    if (!button) return
    const label = button.querySelector("[data-copy-label]")
    if (!label) return
    const defaultLabel = label.textContent

    button.addEventListener("click", async () => {
      const email = button.getAttribute("data-copy-email") ?? ""
      try {
        await navigator.clipboard.writeText(email)
        label.textContent = "Copied!"
        setTimeout(() => {
          label.textContent = defaultLabel
        }, 1800)
      } catch {
        // Clipboard API unavailable — no-op, button still shows the email intent.
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyEmail)
  } else {
    initCopyEmail()
  }
</script>
