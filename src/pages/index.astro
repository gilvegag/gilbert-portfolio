---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import WordReveal from "@/components/WordReveal.astro"
import { Badge } from "@/components/ui/badge"

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
)

const skills = [
  "UX Design",
  "UI Design",
  "Product Design",
  "Consulting",
  "Design Systems",
  "HTML/CSS",
  "Figma",
  "Discovery Workshops",
  "Interaction Design",
  "User Testing",
  "Usability Testing",
  "UX Research",
  "Leadership",
  "Mentoring",
  "Cursor AI",
]
---

<BaseLayout
  title="Gilbert Vega — Senior Product Designer"
  description="Senior Product Designer with 12+ years of experience across B2B SaaS, fintech, healthcare, and design systems."
>
  <section
    data-reveal-group
    class="mx-auto flex w-full max-w-[1400px] flex-col gap-10 px-6 py-16 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:px-14 lg:py-28"
  >
    <div class="flex max-w-2xl flex-col gap-6">
      <h1 class="text-xl leading-snug font-normal tracking-tight text-foreground sm:text-2xl lg:text-3xl">
        <WordReveal text="Product designer with over a decade of experience designing complex products and shaping design systems. I work end to end, bring strong visual craft, and know how to close the gap between design and engineering." />
      </h1>
      <div data-reveal class="flex flex-wrap gap-2">
        <Badge variant="secondary">Senior Product Designer</Badge>
        <Badge variant="secondary">12+ years of experience</Badge>
        <Badge variant="secondary">B2B | SaaS | 0-1</Badge>
      </div>
    </div>
    <div
      data-reveal
      class="w-52 shrink-0 self-center rotate-[-4deg] bg-white p-3 pb-8 shadow-xl shadow-black/15 transition-transform duration-300 ease-in-out hover:rotate-0 hover:scale-[1.02] lg:w-72 lg:self-auto xl:w-80 dark:bg-card dark:shadow-black/40"
    >
      <img
        src="/images/home/profile.png"
        alt="Gilbert Vega"
        class="aspect-square w-full object-cover"
      />
    </div>
  </section>

  <section
    id="work"
    data-reveal-group
    class="mx-auto w-full max-w-[1400px] px-6 pb-24 sm:px-8 lg:px-14"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      Work
    </p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section
    id="about"
    data-reveal-group
    class="mx-auto w-full max-w-[1400px] px-6 pb-24 sm:px-8 lg:px-14"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      About
    </p>
    <div class="flex max-w-2xl flex-col gap-12">
      <div data-reveal class="flex flex-col gap-6">
        <p class="text-base leading-relaxed text-muted-foreground">
          I've been working in UX and product design since 2012. Over the past
          five years, I've really enjoyed focusing on consulting for enterprise
          solutions in B2B, fintech, and healthcare. I find these areas
          fascinating because they present such interesting challenges to
          tackle.
        </p>
        <p class="text-base leading-relaxed text-muted-foreground">
          I love sharing what I've learned, but I'm also a continuous learner
          myself. Attending conferences, speaking about design, and discovering
          new methods and technologies is a big part of what keeps me excited
          about this field. I'm always eager to pick up new skills. I'm
          currently experimenting with AI using Cursor, Figma MCP and Figma
          Make.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-4">
        <h2 class="text-sm font-medium tracking-wide text-muted-foreground uppercase">
          Skills
        </h2>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => <Badge variant="secondary">{skill}</Badge>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
