---
// Stacking-cards home layout — case study cards laid out image-left/
// text-right with a sticky scroll-stack (inspired by athos.framer.website),
// replacing the original 3-column grid. See src/pages/home-grid.astro for
// the archived grid version.
import { getCollection } from "astro:content"
import { Figma, Rocket } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import CraftCard from "@/components/CraftCard.astro"
import ClientLogoMarquee from "@/components/ClientLogoMarquee.astro"
import DitherHoverPhoto from "@/components/DitherHoverPhoto.astro"
// Playful hero tags — small emoji pills instead of plain badges, each with
// its own pastel tone (light/dark aware) and a scattered rotate/lift,
// styled and animated after gerardmarti.info's ".sticker" tags (own CSS,
// same mechanic — see the .tag-sticker rules below). Resting flat/level in
// one row here; the hover pop (lift + scale) still applies.
const heroTags = [
  { emoji: "🧩", label: "Design systems at scale", color: "bg-emerald-100 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200", rotate: "0deg", lift: "0px" },
  { emoji: "🛡️", label: "Regulated healthtech and fintech", color: "bg-orange-100 text-orange-900 dark:bg-orange-950/40 dark:text-orange-200", rotate: "0deg", lift: "0px" },
  { emoji: "🏗️", label: "Zero-to-one Lead UX", color: "bg-violet-100 text-violet-900 dark:bg-violet-950/40 dark:text-violet-200", rotate: "0deg", lift: "0px" },
]

// Shorter pull-quote versions of the full testimonials inside the case
// studies (see oatfi.md / accuray-radiotherapy.md), plus net-new ones from
// Ronald and Luis. `company` is optional — not every quote has one on file,
// and the byline below collapses to just the role when it's missing.
const testimonials: {
  quote: string
  author: string
  role: string
  company?: string
  avatar?: string
  linkedin?: string
}[] = [
  {
    quote:
      "Gil took dense, sensitive financial data and found a structure that didn't sacrifice accuracy for simplicity. Setting clear design standards across the product.",
    author: "Paola Calderón",
    role: "Product Manager",
    company: "OatFi",
    avatar: "/images/projects/oatfi/paola.png",
    linkedin: "https://www.linkedin.com/in/paola-calder%C3%B3n-g%C3%B3mez-2802566a/",
  },
  {
    quote:
      "He turns complexity into clarity. He asks the right questions, surfaces edge cases early, and aligns stakeholders fast. He raised the bar for our UX practice.",
    author: "Cristina Negrut",
    role: "Staff Engineer, Usability and UX Lead",
    company: "Accuray",
    avatar: "/images/projects/accuray-radiotherapy/cristina.jpeg",
    linkedin: "https://www.linkedin.com/in/cristina-negrut-30b7511/",
  },
  {
    quote:
      "He understood our brand deeply and quickly. He's precise, proactive with suggestions, and incredibly easy to collaborate with. The most effective designer I've worked with.",
    author: "Ronald Maltés",
    role: "Founder",
    company: "Therapp",
    avatar: "/images/home/ronald.jpeg",
    linkedin: "https://www.linkedin.com/in/ronaldmaltes/",
  },
  {
    quote:
      "Gil is rare among designers in how deeply he understands front-end constraints. He designs with component reusability and implementation in mind, which made design-to-engineering handoffs remarkably smooth.",
    author: "Luis Pizarro",
    role: "Senior Software Developer",
    company: "Gorilla Logic",
    avatar: "/images/home/pizarro.jpeg",
  },
]

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
)

const cardStats: Record<string, { statLine: string; secondaryTag?: string }> = {
  accuray: { statLine: "25% faster workflow", secondaryTag: "B2B Healthtech" },
  oatfi: { statLine: "10+ deals closed", secondaryTag: "Fintech · 0→1 product" },
}

const carouselImagesBySlug: Record<string, { src: string; alt?: string; fit?: "cover" | "contain"; position?: string }[]> = {
  oatfi: [
    { src: "/images/projects/oatfi/oatfi_thumbnail_vertical.png", alt: "OatFi product dashboard", fit: "contain" },
    { src: "/images/projects/oatfi/car02.png", alt: "OatFi interface", fit: "contain" },
    { src: "/images/projects/oatfi/car03.png", alt: "OatFi interface", fit: "contain" },
  ],
  accuray: [
    // First image: original crop — padding on 3 sides, crops at right like the pre-carousel card
    { src: "/images/projects/accuray-radiotherapy/accuray_main_thumbnail.png", alt: "Accuray main dashboard", fit: "cover", position: "left top", slidePadding: "2.5rem 0 2.5rem 2.5rem" },
    // New images: centered so they read cleanly
    { src: "/images/projects/accuray-radiotherapy/Main dashboard - Venus.png", alt: "Accuray Venus dashboard", fit: "contain" },
    { src: "/images/projects/accuray-radiotherapy/modal.png", alt: "Accuray modal dialog", fit: "contain" },
  ],
}

// Text-left/image-right "detail" card format — see the "detail" variant
// note on ProjectCard.astro. Scoped per-project here.
const detailRowsBySlug: Record<string, { label: string; text: string }[]> = {
  oatfi: [
    {
      label: "Challenge & context",
      text: "A lending product that only existed in code, invisible outside engineering.",
    },
    {
      label: "Role & scope",
      text: "Sole product designer for 15 months, working directly with the CEO, CTO and PM.",
    },
    {
      label: "What I led",
      text: "Set the direction for three connected experiences on one shared foundation, not a single tool with permission toggles.",
    },
    {
      label: "Impact & evidence",
      text: "More than 10 enterprise partners closed with no engineer in the room, team fully self sufficient.",
    },
  ],
  accuray: [
    {
      label: "Challenge & context",
      text: "Two legacy radiotherapy systems to merge, and no shared design foundation underneath either.",
    },
    {
      label: "Role & scope",
      text: "Four years, from a team of three designers to sole owner, working with a usability lead, SMEs, and full stack devs.",
    },
    {
      label: "What I led",
      text: "Rebuilt the clinical workflow on one shared layout, then built the design system that let it scale.",
    },
    {
      label: "Impact & evidence",
      text: "25% faster updates, 90% component coverage, ~1,600 hours saved in the first quarter.",
    },
  ],
}
---

<BaseLayout
  title="Gilbert Vega — Senior Product Designer"
  description="Senior Product Designer with 12+ years of experience across B2B SaaS, fintech, healthcare, and design systems."
>
  <section
    data-reveal-group
    class="mx-auto flex w-full max-w-[1128px] flex-col gap-6 px-6 py-8 sm:px-8 lg:px-14 lg:py-12"
  >
    <div class="flex flex-col gap-8 lg:flex-row lg:justify-start lg:gap-12">
      <div data-reveal class="w-40 shrink-0 self-center lg:h-auto lg:w-72 lg:self-stretch">
        <DitherHoverPhoto
          src="/images/home/shadertrans.png"
          alt="Gilbert Vega"
          class="h-full w-full"
          aspectClass="aspect-square lg:aspect-auto lg:h-full"
          framingClass="translate-x-[3%] translate-y-[6%]"
        />
      </div>
      <div class="flex min-w-0 max-w-2xl flex-col gap-4">
        <p
          data-reveal
          class="text-xs font-semibold text-balance tracking-[0.1em] text-muted-foreground uppercase"
        >
          Senior Product Designer / Design Engineer
        </p>
        <div class="@container">
          <h1
            data-reveal
            class="text-3xl leading-tight font-semibold tracking-tight text-pretty text-foreground sm:text-4xl lg:text-4xl"
          >
            I design complex product workflows<br class="inline @[665px]:hidden" /> and<br class="hidden @[665px]:inline" />
            turn them into<br class="inline @[665px]:hidden" /> clear, shippable&nbsp;systems.
          </h1>
        </div>
        <p data-reveal class="max-w-[70ch] text-base leading-normal text-pretty text-foreground">
          With a foundation in frontend development and <strong class="font-semibold">12+ years</strong> in
          design, I help technical teams turn complex problems into scalable
          products, bridging design intent and code, whether that's building
          zero-to-one or evolving what already exists.
        </p>
        <div
          data-reveal-group
          class="flex flex-wrap items-center gap-4 pt-4"
        >
          {heroTags.map((tag) => (
            <span
              data-reveal
              class:list={[
                "tag-sticker inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[13px] font-medium ring-1 ring-foreground/10",
                tag.color,
              ]}
              style={{ "--rotate": tag.rotate, "--lift": tag.lift }}
            >
              <span aria-hidden="true">{tag.emoji}</span>
              {tag.label}
            </span>
          ))}
        </div>
      </div>
    </div>
    <div data-reveal class="w-full min-w-0 overflow-hidden pt-0 lg:pt-12">
      <ClientLogoMarquee />
    </div>
  </section>

  <section
    id="work"
    data-reveal-group
    class="mx-auto w-full max-w-[1128px] px-6 pt-4 pb-24 sm:px-8 lg:px-14 lg:pt-8"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      Selected Work
    </p>
    <div class="flex flex-col gap-12">
      {projects.map((project, i) => {
        // Sticky scroll-stack only above lg — on phones the sticky
        // positioning made the cards overlap/jump awkwardly, so they just
        // stack normally in flow there instead.
        const cardVars = { "--card-top": `${100 + i * 40}px`, "--card-z": `${i + 1}` }
        const stat = cardStats[project.slug]
        const rows = detailRowsBySlug[project.slug]
        const carouselImages = carouselImagesBySlug[project.slug]
        return (
          <div class="static lg:sticky lg:top-[var(--card-top)] lg:z-[var(--card-z)]" style={cardVars}>
            {rows ? (
              <ProjectCard project={project} variant="detail" rows={rows} statLine={stat?.statLine} carouselImages={carouselImages} />
            ) : stat ? (
              <ProjectCard
                project={project}
                variant="landscape"
                statLine={stat.statLine}
                secondaryTag={stat.secondaryTag}
              />
            ) : (
              <ProjectCard project={project} variant="landscape" />
            )}
          </div>
        )
      })}
      {/* Fourth card — the craft showcase, not a case study. Continues the
          sticky stack after the last project (hence projects.length as its
          index) so it lands on top of the pile. */}
      <div
        class="static lg:sticky lg:top-[var(--card-top)] lg:z-[var(--card-z)]"
        style={{ "--card-top": `${100 + projects.length * 40}px`, "--card-z": `${projects.length + 1}` }}
      >
        <CraftCard />
      </div>
    </div>
  </section>

  <section
    data-reveal-group
    class="mx-auto w-full max-w-[1128px] px-6 pb-16 sm:px-8 lg:px-14"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      People notice how I work
    </p>
    {/* Grid rather than a CSS masonry (columns-*): auto-rows-fr forces every
        row to the same height, so all four cards match and their bylines
        line up along a single baseline. */}
    <div class="testimonial-grid grid grid-cols-1 gap-5 md:auto-rows-fr md:grid-cols-2">
      {testimonials.map((t, i) => (
        <div
          data-reveal
          class:list={["testimonial-card flex h-full flex-col gap-6 rounded-xl bg-card p-6", i % 2 === 1 && "testimonial-card-alt"]}
        >
          <div class="flex flex-col">
            <span class="-mb-2 text-6xl leading-none font-black text-muted-foreground/40" aria-hidden="true">
              &ldquo;
            </span>
            <p class="text-lg leading-relaxed text-foreground">{t.quote}</p>
          </div>
          <div class="mt-auto flex items-center gap-3">
            {t.avatar && (
              <img src={t.avatar} alt={t.author} class="size-9 rounded-full object-cover" />
            )}
            <div class="text-sm">
              {t.linkedin ? (
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-foreground hover:underline"
                >
                  {t.author}
                </a>
              ) : (
                <span class="font-medium text-foreground">{t.author}</span>
              )}
              <p class="text-muted-foreground">{[t.role, t.company].filter(Boolean).join(", ")}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto w-full max-w-[1128px] px-6 pb-16 sm:px-8 lg:px-14">
    <div
      data-reveal
      class="flex flex-col items-center gap-8 border-t border-border pt-12 text-center"
    >
      <p class="max-w-2xl text-base leading-snug font-normal tracking-tight text-foreground sm:text-lg lg:text-xl">
        Designed in Figma. Built with Astro and Claude Code.
      </p>
      <div class="flex items-center gap-6 text-muted-foreground">
        <Figma aria-label="Figma" className="size-5" strokeWidth={1.5} />
        <Rocket aria-label="Astro" className="size-5" strokeWidth={1.5} />
        <span
          role="img"
          aria-label="Claude Code"
          class="inline-block size-5 bg-current"
          style="mask-image:url(/images/logos/claude.png); -webkit-mask-image:url(/images/logos/claude.png); mask-size:contain; -webkit-mask-size:contain; mask-repeat:no-repeat; -webkit-mask-repeat:no-repeat; mask-position:center; -webkit-mask-position:center;"
        />
      </div>
    </div>
  </section>

  <span data-hover-tag aria-hidden="true"></span>
</BaseLayout>

<style>
  /* Testimonial cards get a heavier settle-in than the site's default
     data-reveal (slight scale + tilt easing to flat), closer to the
     parallax-in feel on emanuelsfolio.framer.website's testimonial wall —
     alternating cards tilt the opposite way so the wall doesn't feel
     mechanically uniform. */
  [data-reveal].testimonial-card {
    transform: translateY(48px) scale(0.94) rotate(-1.5deg);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.25s ease;
  }
  [data-reveal].testimonial-card.testimonial-card-alt {
    transform: translateY(48px) scale(0.94) rotate(1.5deg);
  }
  [data-reveal].testimonial-card.is-revealed {
    transform: none;
  }

  /* Hovering one card dims the rest so the one you're reading holds focus.
     Dims with filter: opacity() rather than the opacity property on
     purpose — opacity is already driven by the scroll-reveal above on the
     same elements, over a much longer duration, so reusing it would make
     the two fight. filter is a separate property with its own quick
     transition (declared above), leaving the reveal untouched.

     Note the :not(:hover) — the dim targets the siblings directly rather
     than dimming everything and re-brightening the hovered one. That
     second approach loses the cascade: :has() contributes its argument's
     specificity, so the dim rule outweighs a plain .card:hover rule and
     would flatten every card, hovered included. */
  .testimonial-grid:has(.testimonial-card:hover) .testimonial-card:not(:hover) {
    filter: opacity(0.4);
  }
  /* Touch devices keep :hover stuck after a tap, which would leave cards
     dimmed with no way to clear it. */
  @media (hover: none) {
    .testimonial-grid:has(.testimonial-card:hover) .testimonial-card:not(:hover) {
      filter: none;
    }
  }

  /* Hero tags styled and animated like gerardmarti.info's ".sticker" tags:
     a paper-cutout pill sitting at its own rotate/lift, straightening and
     popping up on hover. Same mechanic, own colors (see heroTags above). */
  .tag-sticker {
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.4),
      0 3px 8px rgba(17, 17, 17, 0.04),
      0 12px 24px rgba(17, 17, 17, 0.04);
  }
  [data-reveal].tag-sticker {
    transform: rotate(var(--rotate)) translateY(calc(var(--lift) + 20px));
  }
  [data-reveal].tag-sticker.is-revealed {
    transform: rotate(var(--rotate)) translateY(var(--lift));
  }
  [data-reveal].tag-sticker.is-revealed:hover {
    transform: rotate(0deg) translateY(calc(var(--lift) - 6px)) scale(1.045);
    z-index: 2;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.45),
      0 8px 18px rgba(17, 17, 17, 0.08),
      0 22px 40px rgba(17, 17, 17, 0.06);
  }

  [data-hover-tag] {
    position: fixed;
    z-index: 300;
    pointer-events: none;
    background: black;
    color: white;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    opacity: 0;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }
  [data-hover-tag].is-visible {
    opacity: 1;
  }
</style>

<script>
  function initHoverTags() {
    const tag = document.querySelector<HTMLSpanElement>("[data-hover-tag]")
    if (!tag) return

    function attach(elements: NodeListOf<HTMLElement>, label: string) {
      elements.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          tag!.textContent = label
          tag!.classList.add("is-visible")
        })
        el.addEventListener("mouseleave", () => tag!.classList.remove("is-visible"))
        el.addEventListener("mousemove", (e) => {
          tag!.style.left = `${e.clientX + 16}px`
          tag!.style.top = `${e.clientY + 16}px`
        })
      })
    }

    attach(document.querySelectorAll<HTMLElement>("#work a"), "View")
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHoverTags)
  } else {
    initHoverTags()
  }
</script>
