---
import { getCollection } from "astro:content"
import { Figma, Rocket, Linkedin, Copy } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import { Badge } from "@/components/ui/badge"

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
)

const skills = [
  "UX Design",
  "UI Design",
  "Product Design",
  "Consulting",
  "Design Systems",
  "HTML/CSS",
  "Figma",
  "Discovery Workshops",
  "Interaction Design",
  "User Testing",
  "Usability Testing",
  "UX Research",
  "Leadership",
  "Mentoring",
  "Cursor AI",
]
---

<BaseLayout
  title="Gilbert Vega — Senior Product Designer"
  description="Senior Product Designer with 12+ years of experience across B2B SaaS, fintech, healthcare, and design systems."
>
  <section
    data-reveal-group
    class="mx-auto flex w-full max-w-[1400px] flex-col gap-10 px-6 py-12 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:px-14 lg:py-20"
  >
    <div class="flex max-w-2xl flex-col gap-6">
      <h1
        data-reveal
        class="text-xl leading-snug font-normal tracking-tight text-foreground sm:text-2xl lg:text-3xl"
      >
        Product designer with over a decade of experience designing complex
        products and shaping design systems. I work end to end, bring strong
        visual craft, and know how to close the gap between design and
        engineering.
      </h1>
      <div data-reveal class="flex flex-wrap gap-2">
        <Badge variant="secondary">Senior Product Designer</Badge>
        <Badge variant="secondary">12+ years of experience</Badge>
        <Badge variant="secondary">B2B | SaaS | 0-1</Badge>
      </div>
    </div>
    <div
      data-reveal
      class="w-52 shrink-0 self-center overflow-hidden rounded-xl ring-1 ring-foreground/10 lg:w-72 lg:self-auto xl:w-80"
    >
      <img
        src="/images/home/profile.png"
        alt="Gilbert Vega"
        class="aspect-square w-full object-cover"
      />
    </div>
  </section>

  <section
    id="work"
    data-reveal-group
    class="mx-auto w-full max-w-[1400px] px-6 pb-24 sm:px-8 lg:px-14"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      Selected Work
    </p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section
    id="about"
    data-reveal-group
    class="mx-auto w-full max-w-[1400px] px-6 pb-24 sm:px-8 lg:px-14"
  >
    <p class="mb-6 text-xs font-medium tracking-[0.1em] text-muted-foreground uppercase">
      About
    </p>
    <div class="flex max-w-2xl flex-col gap-12">
      <div data-reveal class="flex flex-col gap-6">
        <p class="text-base leading-relaxed text-muted-foreground">
          I've been designing since 2012. I started as a graphic designer,
          moved into front-end development, then into visual and product
          design. Over the past five years, I've focused on enterprise B2B
          consulting in fintech and healthcare, where the problems are messy,
          the systems are complex, and the design decisions actually matter.
        </p>
        <p class="text-base leading-relaxed text-muted-foreground">
          That path trained me to think in systems and components before
          pixels. I see the full picture first, then zoom into the specific
          problem worth solving. It also made me tool-agnostic: when you
          understand the underlying patterns, picking up a new tool is just
          syntax. Right now that means applying AI to my workflow with
          Claude Code and Cursor, and I'm genuinely curious about shaping how
          AI shows up in products people use.
        </p>
        <p class="text-base leading-relaxed text-muted-foreground">
          I'm comfortable in ambiguity. I like being the one who finds the
          structure in it.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-4">
        <h2 class="text-sm font-medium tracking-wide text-muted-foreground uppercase">
          Skills
        </h2>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => <Badge variant="secondary">{skill}</Badge>)}
        </div>
      </div>

      <div data-reveal class="flex flex-col gap-4">
        <p class="text-2xl font-semibold text-foreground">Contact me</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://www.linkedin.com/in/gilvega/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
          >
            <Linkedin className="size-4" />
            LinkedIn
          </a>
          <button
            type="button"
            data-copy-email="gilberthvg@gmail.com"
            class="inline-flex items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-foreground/10"
          >
            <Copy className="size-4" />
            <span data-copy-label>Email</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-[1400px] px-6 pb-16 sm:px-8 lg:px-14">
    <div
      data-reveal
      class="flex flex-col items-center gap-8 border-t border-border pt-12 text-center"
    >
      <p class="max-w-2xl text-base leading-snug font-normal tracking-tight text-foreground sm:text-lg lg:text-xl">
        Designed in Figma. Built with Astro and Claude Code.
      </p>
      <div class="flex items-center gap-6 text-muted-foreground">
        <Figma aria-label="Figma" className="size-5" strokeWidth={1.5} />
        <Rocket aria-label="Astro" className="size-5" strokeWidth={1.5} />
        <span
          role="img"
          aria-label="Claude Code"
          class="inline-block size-5 bg-current"
          style="mask-image:url(/images/logos/claude.png); -webkit-mask-image:url(/images/logos/claude.png); mask-size:contain; -webkit-mask-size:contain; mask-repeat:no-repeat; -webkit-mask-repeat:no-repeat; mask-position:center; -webkit-mask-position:center;"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("main [data-copy-email]")
    if (!button) return
    const label = button.querySelector("[data-copy-label]")
    if (!label) return
    const defaultLabel = label.textContent

    button.addEventListener("click", async () => {
      const email = button.getAttribute("data-copy-email") ?? ""
      try {
        await navigator.clipboard.writeText(email)
        label.textContent = "Copied!"
        setTimeout(() => {
          label.textContent = defaultLabel
        }, 1800)
      } catch {
        // Clipboard API unavailable — no-op, button still shows the email intent.
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyEmail)
  } else {
    initCopyEmail()
  }
</script>
