---
import { ArrowRight } from "lucide-react"
import { craftStatement, craftTheme } from "@/data/craft"
import { themeGradient } from "@/data/project-colors"

const carouselBg = themeGradient(craftTheme)

// Mobile-only shots: portrait phone screens, ordered for visual rhythm
const mobileImages = [
  { src: "/images/home/carousel/01top.png",    alt: "Therapp exercise screen" },
  { src: "/images/home/carousel/01bottom.png", alt: "Bond splash screen" },
  { src: "/images/home/carousel/02bottom.png", alt: "Bond sign-in screen" },
  { src: "/images/home/carousel/03bottom.png", alt: "Bond scheduling screen" },
  { src: "/images/home/carousel/04top.png",    alt: "Verizon PopData screen" },
]
---

<a
  href="/craft"
  data-reveal
  class="group flex flex-col overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10 transition-colors hover:ring-foreground/20 lg:flex-row"
>
  <!-- Left: text content -->
  <div class="flex flex-col gap-4 bg-white p-8 lg:w-3/5 lg:min-h-[540px] lg:justify-start lg:gap-5 lg:p-12 dark:bg-transparent">
    <h3 class="max-w-[24ch] text-3xl font-medium tracking-tight text-pretty text-foreground">
      {craftStatement}
    </h3>
    <p class="max-w-[48ch] text-sm leading-relaxed text-muted-foreground">
      These are projects where I shaped the visual identity from the ground up or rebuilt
      what was there. Type, color, hierarchy, and layout doing real work inside the product,
      not sitting on top of it.
    </p>
    <span class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
      See the visual work
      <ArrowRight className="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" />
    </span>
  </div>

  <!-- Right: single drifting row of phone screens -->
  <div
    style={carouselBg ? { backgroundImage: carouselBg } : undefined}
    class="craft-phone-stage flex w-full items-center overflow-hidden lg:w-2/5 lg:shrink-0"
  >
    <ul class="craft-phone-track flex shrink-0 items-end gap-4">
      {[...mobileImages, ...mobileImages].map((img, i) => (
        <li class:list={["craft-phone-item shrink-0", i % 2 === 0 ? "mb-6" : "mt-6"]}>
          <img
            src={img.src}
            alt={img.alt}
            class="h-60 w-auto rounded-2xl object-cover shadow-xl sm:h-72 lg:h-72"
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</a>

<style>
  .craft-phone-stage {
    min-height: 260px;
  }
  @media (min-width: 640px) { .craft-phone-stage { min-height: 300px; } }

  .craft-phone-track {
    animation: craft-drift 32s linear infinite;
    width: max-content;
    will-change: transform;
  }

  @keyframes craft-drift {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

</style>
