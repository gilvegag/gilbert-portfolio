---
import { Linkedin, Copy } from "lucide-react"
import { ThemeToggle } from "./ThemeToggle"

const pillClass =
  "inline-flex items-center gap-1.5 rounded-full border border-foreground/25 px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-foreground/10"
---

<header
  class="mx-auto flex w-full max-w-[1400px] flex-col items-start gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-0 sm:px-8 lg:px-14"
>
  <a href="/" class="text-base font-bold text-foreground">
    GILBERT VEGA
  </a>
  <nav class="flex flex-wrap items-center gap-6 text-sm">
    <a href="/#work" class="text-muted-foreground transition-colors hover:text-foreground">
      Work
    </a>
    <a href="/#about" class="text-muted-foreground transition-colors hover:text-foreground">
      About
    </a>
    <div class="flex items-center gap-2">
      <a
        href="https://www.linkedin.com/in/gilvega/"
        target="_blank"
        rel="noopener noreferrer"
        class={pillClass}
      >
        <Linkedin className="size-3.5" />
        LinkedIn
      </a>
      <button type="button" data-copy-email="gilberthvg@gmail.com" class={pillClass}>
        <Copy className="size-3.5" />
        <span data-copy-label>Email</span>
      </button>
    </div>
    <ThemeToggle client:load />
  </nav>
</header>

<script>
  function initHeaderCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("header [data-copy-email]")
    if (!button) return
    const label = button.querySelector("[data-copy-label]")
    if (!label) return
    const defaultLabel = label.textContent

    button.addEventListener("click", async () => {
      const email = button.getAttribute("data-copy-email") ?? ""
      try {
        await navigator.clipboard.writeText(email)
        label.textContent = "Copied!"
        setTimeout(() => {
          label.textContent = defaultLabel
        }, 1800)
      } catch {
        // Clipboard API unavailable — no-op, button still shows the email intent.
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderCopyEmail)
  } else {
    initHeaderCopyEmail()
  }
</script>
