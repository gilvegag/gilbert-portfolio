---
// Draggable before/after comparison. The "after" image fills the frame;
// the "before" image sits on top, clipped via clip-path to the handle's
// position — dragging the handle (mouse or touch, via Pointer Events)
// updates the clip and both move together.
import { ChevronsLeftRight } from "lucide-react"

interface Props {
  before: string
  after: string
}

const { before, after } = Astro.props
---

<div
  class="before-after-slider relative aspect-video w-full min-w-0 touch-none overflow-hidden bg-black ring-1 ring-border select-none"
>
  <img src={after} alt="After" class="pointer-events-none absolute inset-0 size-full object-contain" draggable="false" />
  <div class="ba-before pointer-events-none absolute inset-0" style="clip-path: inset(0 50% 0 0);">
    <img src={before} alt="Before" class="size-full object-contain" draggable="false" />
  </div>

  <div class="ba-divider pointer-events-none absolute inset-y-0 w-0.5 bg-white/80" style="left: 50%;"></div>

  <button
    type="button"
    class="ba-handle absolute top-1/2 flex size-9 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize items-center justify-center rounded-full bg-white text-neutral-900 shadow-lg"
    style="left: 50%;"
    aria-label="Drag to compare before and after"
  >
    <ChevronsLeftRight className="size-4" />
  </button>

  <span class="pointer-events-none absolute bottom-3 left-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white">
    Before
  </span>
  <span class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white">
    After
  </span>
</div>

<script>
  function initBeforeAfterSliders() {
    document.querySelectorAll<HTMLElement>(".before-after-slider").forEach((container) => {
      const handle = container.querySelector<HTMLElement>(".ba-handle")
      const divider = container.querySelector<HTMLElement>(".ba-divider")
      const beforeLayer = container.querySelector<HTMLElement>(".ba-before")
      if (!handle || !divider || !beforeLayer) return

      function setPosition(clientX: number) {
        const rect = container.getBoundingClientRect()
        const pct = Math.min(100, Math.max(0, ((clientX - rect.left) / rect.width) * 100))
        beforeLayer!.style.clipPath = `inset(0 ${100 - pct}% 0 0)`
        handle!.style.left = `${pct}%`
        divider!.style.left = `${pct}%`
      }

      let dragging = false
      handle.addEventListener("pointerdown", (e) => {
        dragging = true
        handle.setPointerCapture(e.pointerId)
      })
      handle.addEventListener("pointermove", (e) => {
        if (dragging) setPosition(e.clientX)
      })
      handle.addEventListener("pointerup", () => {
        dragging = false
      })
      handle.addEventListener("pointercancel", () => {
        dragging = false
      })
      container.addEventListener("pointerdown", (e) => {
        if (e.target === handle) return
        setPosition(e.clientX)
      })
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBeforeAfterSliders)
  } else {
    initBeforeAfterSliders()
  }
</script>
