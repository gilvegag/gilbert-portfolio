---
// Small infinite-scroll client logo strip, modeled on kaancaglar.design's
// hero logo marquee: grayscale + low opacity so every logo reads as one
// consistent muted tone regardless of its source color, paused on hover.
// Same duplicate-the-list-once-and-animate-to--50% technique already used
// by CommunityPillsMarquee/PptCarousel — the two copies must stay
// identical for the loop to be seamless.
// Every file below is cropped tight to its own visible content (zero
// internal padding, verified via pixel/bbox analysis) so a single shared
// heightClass reads as consistent visual weight across the whole row —
// no per-logo nudging needed. width/height are each file's tight-cropped
// pixel size, used only to reserve the right aspect ratio before load.
const logos = [
  { src: "/images/projects/accuray-radiotherapy/logo.png", alt: "Accuray", heightClass: "h-3.5", width: 990, height: 120 },
  { src: "/images/home/oatfi.svg", alt: "OatFi", heightClass: "h-6", width: 260, height: 91, nudgeUp: 1 },
  { src: "/images/home/verizon.png", alt: "Verizon", heightClass: "h-6", width: 831, height: 183, nudgeUp: 1 },
  { src: "/images/home/legalshield.svg", alt: "LegalShield", heightClass: "h-6", width: 458, height: 91 },
  { src: "/images/home/associa.svg", alt: "Associa", heightClass: "h-6", width: 389, height: 92 },
  { src: "/images/home/therapp.svg", alt: "Therapp", heightClass: "h-6", width: 428, height: 88 },
  { src: "/images/home/academia.svg", alt: "Academia", heightClass: "h-6", width: 505, height: 68 },
]
---

<div
  class="relative mx-auto w-full max-w-2xl min-w-0 overflow-hidden py-1"
  style="mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);"
>
  <ul data-marquee class="logo-marquee-track flex w-max items-center">
    {[...logos, ...logos].map((logo) => (
      <li class:list={["flex shrink-0 items-center mr-14", logo.heightClass]}>
        <img
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          style={logo.nudgeUp ? { transform: `translateY(-${logo.nudgeUp}px)` } : undefined}
          class="h-full w-auto object-contain opacity-45 grayscale invert dark:invert-0"
        />
      </li>
    ))}
  </ul>
</div>

<style>
  .logo-marquee-track {
    animation: marquee-left 32s linear infinite;
    will-change: transform;
  }
</style>
