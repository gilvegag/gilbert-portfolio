---
// Small infinite-scroll client logo strip, modeled on kaancaglar.design's
// hero logo marquee: grayscale + low opacity so every logo reads as one
// consistent muted tone regardless of its source color, paused on hover.
// Same duplicate-the-list-once-and-animate-to--50% technique already used
// by CommunityPillsMarquee/PptCarousel — the two copies must stay
// identical for the loop to be seamless.
// Heights are tuned per logo, not uniform — a wordmark as wide/thin as
// Accuray's or an icon as square as LegalShield's needs a different pixel
// height to *read* the same visual size as OatFi/Verizon at h-6.
// width/height are each file's native pixel size — used only so the
// browser can reserve the right aspect ratio before the image loads (no
// layout shift, which was making the marquee visibly jump as images
// loaded in). heightClass still governs the actual rendered size.
// nudgeUp corrects an optical alignment issue: OatFi's and Verizon's
// bounding boxes are geometrically centered (confirmed), but their glyphs'
// visual weight sits low in the box, reading as sitting lower than the
// rest of the row — a couple px upward nudge compensates.
const logos = [
  { src: "/images/projects/accuray-radiotherapy/logo.png", alt: "Accuray", heightClass: "h-3.5", width: 990, height: 120 },
  { src: "/images/projects/oatfi/logo.png", alt: "OatFi", heightClass: "h-6", width: 677, height: 240, nudgeUp: 2 },
  { src: "/images/home/verizon.png", alt: "Verizon", heightClass: "h-6", width: 1227, height: 272, nudgeUp: 2 },
  { src: "/images/home/legalshield.svg", alt: "LegalShield", heightClass: "h-7", width: 620, height: 138 },
  { src: "/images/home/associa.svg", alt: "Associa", heightClass: "h-6", width: 210, height: 49 },
  { src: "/images/home/therapp.svg", alt: "Therapp", heightClass: "h-6", width: 182, height: 46 },
  { src: "/images/home/academia.svg", alt: "Academia", heightClass: "h-6", width: 236, height: 31 },
]
---

<div
  class="relative mx-auto w-full max-w-2xl min-w-0 overflow-hidden"
  style="mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);"
>
  <ul data-marquee class="logo-marquee-track flex w-max items-center">
    {[...logos, ...logos].map((logo) => (
      <li class:list={["flex shrink-0 items-center mr-14", logo.heightClass]}>
        <img
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          style={logo.nudgeUp ? { transform: `translateY(-${logo.nudgeUp}px)` } : undefined}
          class="h-full w-auto object-contain opacity-45 grayscale invert dark:invert-0"
        />
      </li>
    ))}
  </ul>
</div>

<style>
  .logo-marquee-track {
    animation: marquee-left 32s linear infinite;
  }
</style>
