---
import type { CollectionEntry } from "astro:content"
import { User, Zap, TrendingUp } from "lucide-react"
import { Badge } from "@/components/ui/badge"

interface Props {
  project: CollectionEntry<"projects">
  // "stat" trades the tag badge for a prominent highlighted stat line and
  // drops to two icon rows. "landscape" reuses that same content but laid
  // out image-left/text-right instead of stacked — used on the home page's
  // stacking-cards section. "detail" is a text-left/image-right format
  // with a labeled Q&A-style row list instead of the stat content, used
  // for all 3 home page cards. All scoped by whoever renders them —
  // promote to a frontmatter-driven layout choice once validated.
  variant?: "grid" | "stat" | "landscape" | "detail"
  statLine?: string
  secondaryTag?: string
  rows?: { label: string; text: string }[]
}

const { project, variant = "grid", statLine, secondaryTag, rows } = Astro.props
const {
  title,
  role,
  thumbnail,
  thumbnailVertical,
  thumbnailLandscape,
  thumbnailFit,
  thumbnailAspect,
  cardTag,
  cardDescription,
  cardHighlight,
  cardImpact,
} = project.data

const isDetail = variant === "detail"
const isLandscape = variant === "landscape" || isDetail
const isStat = variant === "stat" || (isLandscape && !isDetail)

const mobileImg = thumbnailLandscape ?? thumbnail
const desktopImg = thumbnailVertical ?? thumbnail
const isCoverRight = thumbnailFit === "cover-right"
---

<a
  href={`/work/${project.slug}`}
  data-reveal
  class:list={[
    "group flex flex-col overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10 transition-colors hover:ring-foreground/20",
    isLandscape && "lg:w-full lg:flex-row",
  ]}
>
  <div
    class:list={[
      "w-full overflow-hidden bg-muted",
      isLandscape && "lg:w-2/5 lg:shrink-0",
      isDetail && "lg:order-2",
    ]}
  >
    {isCoverRight ? (
      <>
        {/* Mobile: crop anchored top-left, breathing room on top/left */}
        <div class="aspect-video w-full overflow-hidden pt-6 pl-6 md:hidden">
          <img
            src={mobileImg}
            alt={title}
            class="size-full object-cover object-left-top transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
        {/* Desktop: square frame (matches card height across the grid), crop anchored left, breathing room on top/left/bottom */}
        <div class="hidden aspect-square w-full overflow-hidden pt-10 pb-10 pl-10 md:block">
          <img
            src={desktopImg}
            alt={title}
            class="size-full object-cover object-left transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      </>
    ) : (
      <>
        {/* Mobile: full image, contained and centered, exact fit (no letterbox gap) */}
        <div class="px-6 pt-6 md:hidden">
          <div class="w-full overflow-hidden" style={{ aspectRatio: thumbnailAspect }}>
            <img
              src={mobileImg}
              alt={title}
              class="size-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>
        </div>
        {/* Desktop: square frame (matches card height across the grid), image touches the bottom */}
        <div class="hidden aspect-square w-full overflow-hidden px-6 pt-6 md:block">
          <img
            src={desktopImg}
            alt={title}
            class="size-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      </>
    )}
  </div>
  {isDetail ? (
    <div class="flex flex-col gap-4 p-6 lg:order-1 lg:w-3/5 lg:justify-center lg:gap-5 lg:p-8">
      <h3 class="text-3xl font-medium tracking-tight text-foreground">{title}</h3>
      {statLine && (
        <div class="flex items-center gap-2 text-base font-medium text-blue-600 dark:text-blue-400">
          <TrendingUp className="size-4 shrink-0" />
          <span>{statLine}</span>
        </div>
      )}
      <div class="flex flex-col divide-y divide-border">
        {rows?.map((row) => (
          <div class="grid grid-cols-1 gap-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-[160px_1fr] sm:gap-6">
            <p class="text-sm font-semibold text-foreground">{row.label}</p>
            <p class="text-sm leading-relaxed text-muted-foreground">{row.text}</p>
          </div>
        ))}
      </div>
    </div>
  ) : isStat ? (
    <div class:list={["flex flex-col gap-3 p-6", isLandscape && "lg:w-3/5 lg:justify-center"]}>
      <h3 class="text-xl font-medium text-foreground">{title}</h3>
      {statLine && (
        <div class="flex items-center gap-2 text-base font-medium text-blue-600 dark:text-blue-400">
          <TrendingUp className="size-4 shrink-0" />
          <span>{statLine}</span>
        </div>
      )}
      {cardDescription && <p class="text-sm leading-relaxed text-muted-foreground">{cardDescription}</p>}
      <div class="flex flex-col gap-2.5 opacity-60 transition-opacity duration-300 group-hover:opacity-100">
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <User className="size-4 shrink-0 text-muted-foreground" />
          <span>{role}</span>
        </div>
        {secondaryTag && (
          <div class="flex items-center gap-2.5 text-sm text-foreground">
            <Zap className="size-4 shrink-0 text-muted-foreground" />
            <span>{secondaryTag}</span>
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="flex flex-col gap-4 p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-medium text-foreground">{title}</h3>
        <div>
          <Badge variant="secondary">{cardTag}</Badge>
        </div>
        {cardDescription && <p class="text-sm leading-relaxed text-muted-foreground">{cardDescription}</p>}
      </div>
      <div class="flex flex-col gap-2.5 opacity-60 transition-opacity duration-300 group-hover:opacity-100">
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <User className="size-4 shrink-0 text-muted-foreground" />
          <span>{role}</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <Zap className="size-4 shrink-0 text-muted-foreground" />
          <span>{cardHighlight}</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <TrendingUp className="size-4 shrink-0 text-muted-foreground" />
          <span>{cardImpact}</span>
        </div>
      </div>
    </div>
  )}
</a>
