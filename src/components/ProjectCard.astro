---
import type { CollectionEntry } from "astro:content"
import { User, Zap, TrendingUp } from "lucide-react"
import { Badge } from "@/components/ui/badge"
import { projectThemes, themeGradient } from "@/data/project-colors"

interface Props {
  project: CollectionEntry<"projects">
  // "stat" trades the tag badge for a prominent highlighted stat line and
  // drops to two icon rows. "landscape" reuses that same content but laid
  // out image-left/text-right instead of stacked — used on the home page's
  // stacking-cards section. "detail" is a text-left/image-right format
  // with a labeled Q&A-style row list instead of the stat content, used
  // for all 3 home page cards. All scoped by whoever renders them —
  // promote to a frontmatter-driven layout choice once validated.
  variant?: "grid" | "stat" | "landscape" | "detail"
  statLine?: string
  secondaryTag?: string
  rows?: { label: string; text: string }[]
  carouselImages?: { src: string; alt?: string; fit?: "cover" | "contain"; position?: string; slidePadding?: string }[]
}

const { project, variant = "grid", statLine, secondaryTag, rows, carouselImages } = Astro.props
const {
  title,
  role,
  thumbnail,
  thumbnailVertical,
  thumbnailLandscape,
  thumbnailFit,
  thumbnailAspect,
  cardTag,
  cardDescription,
  cardHighlight,
  cardImpact,
  company,
  heroLogo,
} = project.data

const isDetail = variant === "detail"
const isLandscape = variant === "landscape" || isDetail
const isStat = variant === "stat" || (isLandscape && !isDetail)

const mobileImg = thumbnailLandscape ?? thumbnail
const desktopImg = thumbnailVertical ?? thumbnail
const isCoverRight = thumbnailFit === "cover-right"

// Each card's image uses a soft gradient of that case study's own brand
// background color (src/data/project-colors.ts) instead of flat --muted —
// a touch lighter on the left, easing into the base color. Same gradient
// as that case study's own hero/footer (see ProjectLayout.astro).
const theme = projectThemes[project.slug]
const imageBg = theme ? themeGradient(theme) : undefined
---

<a
  href={`/work/${project.slug}`}
  data-reveal
  data-view-card={isDetail ? "" : undefined}
  class:list={[
    "group flex flex-col overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10 transition-colors hover:ring-foreground/20",
    isLandscape && "lg:w-full lg:flex-row",
    isDetail && "detail-card",
  ]}
>
  <div
    style={imageBg ? { backgroundImage: imageBg } : undefined}
    class:list={[
      "w-full overflow-hidden",
      !imageBg && "bg-muted",
      isLandscape && "lg:w-2/5 lg:shrink-0",
      isDetail && "order-2",
    ]}
  >
    {isDetail && carouselImages?.length ? (
      /* Carousel — fades between images, dots at the bottom */
      <div class="card-carousel relative aspect-video w-full overflow-hidden md:aspect-auto md:h-full" data-card-carousel>
        {carouselImages.map((img, i) => {
          const useCover = img.fit === "cover" || (!img.fit && isCoverRight && i === 0)
          const imgPosition = img.position ?? (useCover ? "left top" : "center")
          return (
            <div
              class:list={[
                "absolute inset-0 transition-opacity duration-700",
                i === 0 ? "opacity-100" : "opacity-0 pointer-events-none",
              ]}
              style={img.slidePadding ? { padding: img.slidePadding } : undefined}
              data-card-slide
            >
              <img
                src={img.src}
                alt={img.alt ?? title}
                class:list={[
                  "size-full",
                  useCover ? "object-cover" : "object-contain p-6 md:p-10",
                ]}
                style={{ objectPosition: imgPosition }}
                loading={i === 0 ? "eager" : "lazy"}
              />
            </div>
          )
        })}
        <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-2" data-card-dots>
          {carouselImages.map((_, i) => (
            <button
              class:list={[
                "h-1.5 rounded-full transition-all duration-300 bg-white/40",
                i === 0 ? "w-4 bg-white/90" : "w-1.5",
              ]}
              data-card-dot={i}
              aria-label={`Image ${i + 1}`}
            />
          ))}
        </div>
      </div>
    ) : isCoverRight ? (
      <>
        {/* Mobile: crop anchored top-left, breathing room on top/left */}
        <div class="aspect-video w-full overflow-hidden pt-6 pl-6 md:hidden">
          <img
            src={mobileImg}
            alt={title}
            class="size-full object-cover object-left-top transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
        {/* Desktop: fills the full stretched card height */}
        <div
          class:list={[
            "hidden w-full overflow-hidden pt-10 pb-10 pl-10 md:block",
            isDetail ? "h-full" : "aspect-square",
          ]}
        >
          <img
            src={desktopImg}
            alt={title}
            class="size-full object-cover object-left transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      </>
    ) : (
      <>
        {/* Mobile */}
        <div class="px-6 pt-6 md:hidden">
          <div class="w-full overflow-hidden" style={{ aspectRatio: thumbnailAspect }}>
            <img
              src={mobileImg}
              alt={title}
              class="size-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>
        </div>
        {/* Desktop */}
        <div
          class:list={[
            "hidden w-full overflow-hidden px-6 pt-6 md:block",
            isDetail ? "h-full" : "aspect-square",
            project.slug === "oatfi" && "pb-6",
          ]}
        >
          <img
            src={desktopImg}
            alt={title}
            class="size-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      </>
    )}
  </div>
  {isDetail ? (
    <div class="order-1 flex flex-col gap-4 bg-white p-8 lg:w-3/5 lg:justify-center lg:gap-5 lg:p-12 dark:bg-transparent">
      {heroLogo && (
        <img
          src={heroLogo}
          alt={company}
          class:list={[
            "w-auto self-start object-contain invert dark:invert-0",
            project.slug === "oatfi" ? "h-5" : "h-3.5",
          ]}
        />
      )}
      <h3 class="text-3xl font-medium text-pretty tracking-tight text-foreground">{title}</h3>
      {statLine && (
        <div class="flex items-center gap-2 text-base font-medium text-blue-600 dark:text-blue-400">
          <TrendingUp className="size-4 shrink-0" />
          <span>{statLine}</span>
        </div>
      )}
      <div class="flex flex-col divide-y divide-border">
        {rows?.map((row) => (
          <div class="grid grid-cols-1 gap-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-[160px_1fr] sm:gap-6">
            <p class="text-sm font-semibold text-foreground">{row.label}</p>
            <p class="text-sm leading-relaxed text-muted-foreground">{row.text}</p>
          </div>
        ))}
      </div>
    </div>
  ) : isStat ? (
    <div class:list={["flex flex-col gap-3 p-6", isLandscape && "lg:w-3/5 lg:justify-center"]}>
      <h3 class="text-xl font-medium text-pretty text-foreground">{title}</h3>
      {statLine && (
        <div class="flex items-center gap-2 text-base font-medium text-blue-600 dark:text-blue-400">
          <TrendingUp className="size-4 shrink-0" />
          <span>{statLine}</span>
        </div>
      )}
      {cardDescription && <p class="text-sm leading-relaxed text-muted-foreground">{cardDescription}</p>}
      <div class="flex flex-col gap-2.5 opacity-60 transition-opacity duration-300 group-hover:opacity-100">
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <User className="size-4 shrink-0 text-muted-foreground" />
          <span>{role}</span>
        </div>
        {secondaryTag && (
          <div class="flex items-center gap-2.5 text-sm text-foreground">
            <Zap className="size-4 shrink-0 text-muted-foreground" />
            <span>{secondaryTag}</span>
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="flex flex-col gap-4 p-6">
      <div class="flex flex-col gap-2">
        <h3 class="text-lg font-medium text-pretty text-foreground">{title}</h3>
        <div>
          <Badge variant="secondary">{cardTag}</Badge>
        </div>
        {cardDescription && <p class="text-sm leading-relaxed text-muted-foreground">{cardDescription}</p>}
      </div>
      <div class="flex flex-col gap-2.5 opacity-60 transition-opacity duration-300 group-hover:opacity-100">
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <User className="size-4 shrink-0 text-muted-foreground" />
          <span>{role}</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <Zap className="size-4 shrink-0 text-muted-foreground" />
          <span>{cardHighlight}</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm text-foreground">
          <TrendingUp className="size-4 shrink-0 text-muted-foreground" />
          <span>{cardImpact}</span>
        </div>
      </div>
    </div>
  )}
</a>

<style>
  .detail-card:hover {
    cursor: pointer;
  }
</style>

<script>
  function initCardCarousels() {
    document.querySelectorAll<HTMLElement>("[data-card-carousel]").forEach((carousel) => {
      if (carousel.dataset.carouselInit) return
      carousel.dataset.carouselInit = "1"

      const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-card-slide]"))
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-card-dot]"))
      if (slides.length < 2) return

      let idx = 0

      function goTo(n: number) {
        slides[idx].classList.add("opacity-0", "pointer-events-none")
        slides[idx].classList.remove("opacity-100")
        dots[idx].classList.remove("w-4", "bg-white/90")
        dots[idx].classList.add("w-1.5", "bg-white/40")

        idx = n
        slides[idx].classList.remove("opacity-0", "pointer-events-none")
        slides[idx].classList.add("opacity-100")
        dots[idx].classList.add("w-4", "bg-white/90")
        dots[idx].classList.remove("w-1.5", "bg-white/40")
      }

      let timer = setInterval(() => goTo((idx + 1) % slides.length), 4000)

      dots.forEach((dot, i) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation()
          e.preventDefault()
          clearInterval(timer)
          goTo(i)
          timer = setInterval(() => goTo((idx + 1) % slides.length), 4000)
        })
      })
    })
  }

  document.addEventListener("DOMContentLoaded", initCardCarousels)
  document.addEventListener("astro:page-load", initCardCarousels)

</script>
