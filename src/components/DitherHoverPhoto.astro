---
// Experiment: swaps the flat muted background behind a transparent cutout
// photo for a "faded dither" halftone shader — variable-radius dots on a
// grid, animating on their own from two slow-drifting blobs, plus a third
// that snaps to the cursor while hovering the photo. Warm neutral grays to
// match the portrait's own studio backdrop (see
// src/pages/shader-hero.astro for the trial). WebGL2, no dependencies.
interface Props {
  src: string
  alt: string
  class?: string
  aspectClass?: string
  // Source image and frame are nearly the same aspect ratio, so plain
  // object-position has no crop headroom to shift into — pass scale-*/
  // translate-* utilities here instead to reframe the subject.
  framingClass?: string
}

const {
  src,
  alt,
  class: className,
  aspectClass = "aspect-[4/5]",
  framingClass = "",
} = Astro.props
---

<div
  data-dither-photo
  class:list={[
    "group relative isolate overflow-hidden rounded-xl",
    className,
  ]}
>
  <canvas data-dither-canvas class="absolute inset-0 h-full w-full"></canvas>
  <img
    src={src}
    alt={alt}
    class:list={["relative z-10 w-full object-cover", aspectClass, framingClass]}
  />
</div>

<script>
  const VERT_SRC = `#version 300 es
    layout(location=0) in vec2 a_pos;
    void main() {
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }
  `

  const FRAG_SRC = `#version 300 es
    precision highp float;
    uniform vec2 u_resolution;
    uniform float u_time;
    uniform vec2 u_mouse;
    uniform float u_mouseStrength;
    out vec4 fragColor;

    // #57534E background with #837658 dots.
    const vec3 bgColor = vec3(0.3412, 0.3255, 0.3059);
    const vec3 dotColor = vec3(0.5137, 0.4627, 0.3451);
    const vec3 dotColorLight = vec3(0.5137, 0.4627, 0.3451);

    // Classic 4x4 Bayer ordered-dither threshold matrix, so density (not
    // per-dot size) is what carries the gradient — matches a true halftone
    // dither rather than one smoothly-scaling square.
    float bayerThreshold(vec2 cellId) {
      int x = int(mod(cellId.x, 4.0));
      int y = int(mod(cellId.y, 4.0));
      int idx = y * 4 + x;
      float m[16] = float[16](
        0.0, 8.0, 2.0, 10.0,
        12.0, 4.0, 14.0, 6.0,
        3.0, 11.0, 1.0, 9.0,
        15.0, 7.0, 13.0, 5.0
      );
      return (m[idx] + 0.5) / 16.0;
    }

    void main() {
      vec2 fragCoord = gl_FragCoord.xy;
      float cell = 5.0;
      vec2 cellId = floor(fragCoord / cell);
      vec2 cellCenter = (cellId + 0.5) * cell;
      vec2 uv = cellCenter / u_resolution;
      float aspect = u_resolution.x / u_resolution.y;
      vec2 uvA = vec2(uv.x * aspect, uv.y);

      // Ambient drift stays parked over the left side of the photo; hover
      // (u_mouse below) is free to roam the full frame.
      vec2 p1 = vec2(0.24 + 0.16 * sin(u_time * 0.15), 0.5 + 0.3 * cos(u_time * 0.12));
      vec2 p2 = vec2(0.22 + 0.14 * cos(u_time * 0.1 + 2.0), 0.45 + 0.26 * sin(u_time * 0.13 + 1.0));
      p1.x *= aspect;
      p2.x *= aspect;

      float d1 = distance(uvA, p1);
      float d2 = distance(uvA, p2);
      float i1 = smoothstep(0.55, 0.0, d1);
      float i2 = smoothstep(0.5, 0.0, d2);
      float intensity = clamp(i1 * 0.5 + i2 * 0.4, 0.0, 1.0);

      vec2 mouseA = vec2(u_mouse.x * aspect, u_mouse.y);
      float dm = distance(uvA, mouseA);
      float im = smoothstep(0.5, 0.0, dm);
      intensity = clamp(intensity + im * u_mouseStrength * 0.5, 0.0, 1.0);

      // Ordered dither: each cell is either fully on or off, decided by
      // comparing local intensity against a Bayer-matrix threshold. Density
      // of "on" cells carries the gradient, not dot size.
      float threshold = bayerThreshold(cellId);
      float on = step(threshold, intensity);

      float sqHalf = cell * 0.5 * 0.82;
      vec2 local = fragCoord - cellCenter;
      float sqDist = max(abs(local.x), abs(local.y)) - sqHalf;
      float mark = (1.0 - smoothstep(-1.0, 1.0, sqDist)) * on;

      vec3 col = mix(dotColor, dotColorLight, intensity * 0.5);
      vec3 outColor = mix(bgColor, col, mark);
      fragColor = vec4(outColor, 1.0);
    }
  `

  function compile(gl: WebGL2RenderingContext, type: number, source: string) {
    const shader = gl.createShader(type)!
    gl.shaderSource(shader, source)
    gl.compileShader(shader)
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.error(gl.getShaderInfoLog(shader))
    }
    return shader
  }

  function initDitherPhoto(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-dither-canvas]")
    if (!canvas) return
    const gl = canvas.getContext("webgl2")
    if (!gl) return

    const program = gl.createProgram()!
    gl.attachShader(program, compile(gl, gl.VERTEX_SHADER, VERT_SRC))
    gl.attachShader(program, compile(gl, gl.FRAGMENT_SHADER, FRAG_SRC))
    gl.linkProgram(program)
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error(gl.getProgramInfoLog(program))
      return
    }
    gl.useProgram(program)

    const buffer = gl.createBuffer()
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW
    )
    gl.enableVertexAttribArray(0)
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0)

    const uResolution = gl.getUniformLocation(program, "u_resolution")
    const uTime = gl.getUniformLocation(program, "u_time")
    const uMouse = gl.getUniformLocation(program, "u_mouse")
    const uMouseStrength = gl.getUniformLocation(program, "u_mouseStrength")

    // Mouse starts parked off-canvas so the reactive blob has no effect
    // until the cursor actually enters the photo.
    let mouseX = -1
    let mouseY = -1
    let mouseStrength = 0
    let mouseStrengthTarget = 0
    const start = performance.now()
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    function resize() {
      const rect = root.getBoundingClientRect()
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas!.width = Math.max(1, Math.round(rect.width * dpr))
      canvas!.height = Math.max(1, Math.round(rect.height * dpr))
      gl!.viewport(0, 0, canvas!.width, canvas!.height)
    }

    function render() {
      mouseStrength += (mouseStrengthTarget - mouseStrength) * 0.08
      gl!.uniform2f(uResolution, canvas!.width, canvas!.height)
      gl!.uniform1f(uTime, prefersReducedMotion ? 0 : (performance.now() - start) / 1000)
      gl!.uniform2f(uMouse, mouseX, 1 - mouseY)
      gl!.uniform1f(uMouseStrength, mouseStrength)
      gl!.drawArrays(gl!.TRIANGLES, 0, 3)
      requestAnimationFrame(render)
    }

    resize()
    window.addEventListener("resize", resize)
    requestAnimationFrame(render)

    root.addEventListener("pointerenter", () => {
      mouseStrengthTarget = 1
    })
    root.addEventListener("pointermove", (e) => {
      const rect = root.getBoundingClientRect()
      mouseX = (e.clientX - rect.left) / rect.width
      mouseY = (e.clientY - rect.top) / rect.height
    })
    root.addEventListener("pointerleave", () => {
      mouseStrengthTarget = 0
    })
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-dither-photo]").forEach(initDitherPhoto)
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init)
  } else {
    init()
  }
</script>
