---
// Two logo cards: Storybook, and Figma + Claude — matches the reference
// screenshot exactly, nothing added beyond it.
import { Plus } from "lucide-react"

const base = "/images/projects/accuray-design-system"
---

<div class="flex w-full min-w-0 flex-col gap-4">
  <div class="flex items-center justify-center rounded-xl bg-muted/40 px-6 py-10">
    <img src={`${base}/storybook.png`} alt="Storybook" class="h-8 w-auto object-contain" />
  </div>
  <div class="flex items-center justify-center gap-4 rounded-xl bg-muted/40 px-6 py-10">
    <img src={`${base}/figma.png`} alt="Figma" class="h-10 w-auto object-contain" />
    <Plus className="size-5 shrink-0 text-muted-foreground" strokeWidth={1.5} />
    <img src={`${base}/claude.png`} alt="Claude" class="h-10 w-auto object-contain" />
  </div>
</div>
