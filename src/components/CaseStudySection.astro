---
import SystemDiagram from "@/components/SystemDiagram.astro"
import CommunityPillsMarquee from "@/components/CommunityPillsMarquee.astro"
import PptCarousel from "@/components/PptCarousel.astro"
import BeforeAfterSlider from "@/components/BeforeAfterSlider.astro"

interface Props {
  heading: string
  body: string
  image?: string
  images?: string[]
  imagePosition?: "right" | "below"
  lightbox?: boolean
  link?: { label: string; href: string }
  visual?: "diagram" | "pills" | "ppt-carousel"
  beforeAfter?: { before: string; after: string }
}

const {
  heading,
  body,
  image,
  images,
  imagePosition = "right",
  lightbox = false,
  link,
  visual,
  beforeAfter,
} = Astro.props
const allImages = images ?? (image ? [image] : [])
const hasImages = allImages.length > 0
const hasVisual = Boolean(visual) || hasImages
// When a section has more than one image, the text column stays pinned
// (desktop only) while the taller image stack scrolls past it, then
// scrolling continues normally into whatever comes next.
const isScrollStack = allImages.length > 1
---

<div class="flex flex-col gap-8">
  <div
    class:list={[
      "gap-8",
      !hasVisual
        ? "flex flex-col"
        : imagePosition === "right"
          ? [
              "grid grid-cols-1 md:grid-cols-2",
              "md:items-start",
            ]
          : "flex flex-col",
    ]}
  >
    <div
      class:list={[
        "flex flex-col gap-3",
        isScrollStack && "md:sticky md:top-32 md:self-start",
      ]}
    >
      <h3 class="text-lg font-medium text-foreground">{heading}</h3>
      <p class="text-base leading-relaxed text-muted-foreground">{body}</p>
      {link && (
        <a
          href={link.href}
          class="mt-1 inline-flex w-fit items-center gap-2 rounded-full border border-foreground/25 px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-foreground/10"
        >
          {link.label} &rarr;
        </a>
      )}
    </div>
    {
      visual === "diagram" ? (
        <SystemDiagram />
      ) : visual === "pills" ? (
        <CommunityPillsMarquee />
      ) : visual === "ppt-carousel" ? (
        <PptCarousel />
      ) : hasImages ? (
        <div class="flex flex-col gap-6">
          {allImages.map((src) =>
            lightbox ? (
              <button
                type="button"
                data-lightbox-trigger
                data-lightbox-src={src}
                data-lightbox-alt={heading}
                class="block w-full overflow-hidden rounded-lg ring-1 ring-border"
              >
                <img src={src} alt={heading} class="w-full object-cover" loading="lazy" />
              </button>
            ) : (
              <div class="overflow-hidden rounded-lg ring-1 ring-border">
                <img src={src} alt={heading} class="w-full object-cover" loading="lazy" />
              </div>
            )
          )}
        </div>
      ) : null
    }
  </div>
  {beforeAfter && (
    <div class="mt-6">
      <BeforeAfterSlider before={beforeAfter.before} after={beforeAfter.after} />
    </div>
  )}
</div>
