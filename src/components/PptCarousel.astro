---
// Continuous vertical filmstrip through the pitch deck slides — same
// duplicate-and-loop-to--50% technique as CommunityPillsMarquee, just on
// the Y axis, so each slide can use the full column width instead of being
// squeezed into a narrow horizontal strip.
const base = "/images/projects/accuray-design-system/ppt"
const slideCount = 10
const slides = Array.from({ length: slideCount }, (_, i) => `${base}/slide-${String(i + 1).padStart(2, "0")}.jpg`)
---

<div
  class="relative h-80 w-full min-w-0 overflow-hidden sm:h-96"
  style="mask-image: linear-gradient(to bottom, transparent 0%, black 12.5%, black 87.5%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 12.5%, black 87.5%, transparent 100%);"
>
  <ul
    data-marquee
    class="flex h-max w-full min-w-0 flex-col items-center gap-3"
    style="animation: marquee-up 40s linear infinite;"
  >
    {[...slides, ...slides].map((src, i) => (
      <li class="aspect-video w-full shrink-0 overflow-hidden rounded-lg ring-1 ring-border">
        <img
          src={src}
          alt={`Design system pitch deck, slide ${(i % slideCount) + 1}`}
          class="size-full object-cover"
          loading="lazy"
        />
      </li>
    ))}
  </ul>
</div>
